# Claude Code — commit: skills/, agents/, rules/, hooks/, settings.json
# Ignore: local overrides, credentials, session data

# Tracked: shared config & extensibility
!/.claude/
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/rules/
!.claude/rules/**
!.claude/hooks/
!.claude/hooks/**

# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/

# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# AGENTS.md ignored - our-codex
AGENTS.md

# karr materialized task view -- never commit
tasks/
config.yml
# karr-foundation per-repo state files — local machine only, never commit
.karr
.karr.state
.karr.lock
.karr.log

# Build artifacts
OCP-*/
OCP-*.tar.gz
.build/
.dzil/
_build/
blib/
blibdirs
pm_to_blib
MYMETA.json
MYMETA.yml
Makefile.old

# Carton / local libs
# NOTE: cpanfile.snapshot is TRACKED here (Docker-first: the image build needs
# a reproducible snapshot; regenerate via `make snapshot`, never on the host)
local/
dzil-local/

# Test coverage
.prove
cover_db/
nytprof*

# Editor backups & temp files
*.tar.gz
*.zip
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
.DS_Store

# Local environments
.env
.env.*
.direnv/
.vscode/
.idea/

# OCP project-local state & test data (a real cluster spec lives elsewhere)
.ocp/
tmp/
ocp.yaml
kubeconfig.yaml
share/Rexfile.lock
