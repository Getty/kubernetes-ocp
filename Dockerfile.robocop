# Robocop Controller Image
# Lightweight image for in-cluster controller

FROM perl:5.40-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    libssh-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install cpanm
RUN curl -L https://cpanmin.us | perl - App::cpanminus

# Copy cpanfile first for better caching
COPY cpanfile /app/

# Install Perl dependencies
RUN cpanm --notest --installdeps .

# Copy application code
COPY lib/ /app/lib/
COPY bin/ /app/bin/
COPY share/ /app/share/

# Make binaries executable
RUN chmod +x /app/bin/*

# Add to PATH
ENV PATH="/app/bin:${PATH}"
ENV PERL5LIB="/app/lib:${PERL5LIB}"

# Robocop user (non-root)
RUN useradd -u 1000 -m robocop
USER robocop

ENTRYPOINT ["/app/bin/robocop"]
