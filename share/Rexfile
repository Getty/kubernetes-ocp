desc "Install RKE2 server (control plane)";
task "install_rke2_server", sub {
    my $params = shift;
    my $token = $params->{token} || _generate_token();
    my $version = $params->{version} || '';
    my $tls_san = $params->{tls_san} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Create RKE2 config
    my $config = "cni: none\ndisable-kube-proxy: true\n";
    $config .= "token: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;
    $config .= "tls-san:\n  - $tls_san\n" if $tls_san;
    $config .= "disable:\n  - rke2-ingress-nginx\n";

    file "/etc/rancher/rke2", ensure => 'directory';
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Install RKE2
    say "[1/5] Installing RKE2...";
    my $install_cmd = "curl -sfL https://get.rke2.io | ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$version " if $version;
    $install_cmd .= "sh -";

    my $install_result = run $install_cmd, auto_die => FALSE;

    if ($? != 0) {
        say "ERROR: RKE2 installation failed!";
        say "=== Install Output ===";
        say $install_result;
        say "=== End Install Output ===";
        die "RKE2 install script failed";
    }

    # Verify installation - binary is called 'rke2', not 'rke2-server'
    say "[2/5] Verifying RKE2 binary...";
    my $rke2_bin = run "test -f /usr/local/bin/rke2 && echo OK || echo MISSING", auto_die => FALSE;
    chomp $rke2_bin;

    if ($rke2_bin ne 'OK') {
        say "ERROR: RKE2 binary not found at /usr/local/bin/rke2!";
        say "=== Searching for RKE2 files ===";
        my $search = run "ls -la /usr/local/bin/rke2* 2>&1 || true";
        say $search;
        die "RKE2 binary missing";
    }

    # Start service
    say "[3/5] Enabling and starting RKE2 service...";
    run "systemctl enable rke2-server.service 2>&1", auto_die => FALSE;
    run "systemctl start rke2-server.service 2>&1", auto_die => FALSE;

    # Wait for service to become active (up to 180s for first-time image pulls)
    say "[4/5] Waiting for RKE2 service to become active (up to 3 min)...";
    my $status;
    for my $i (1..36) {
        $status = run "systemctl is-active rke2-server.service", auto_die => FALSE;
        chomp $status;
        if ($status eq 'active') {
            say "      RKE2 service is active after ~" . ($i * 5) . "s";
            last;
        }
        if ($status eq 'failed' || $status eq 'inactive') {
            say "ERROR: rke2-server.service is $status!";
            my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
            say $journal;
            die "RKE2 server failed to start";
        }
        say "      ... still $status (${i}/36)" if $i % 6 == 0;
        sleep 5;
    }

    if ($status ne 'active') {
        say "ERROR: rke2-server.service is not active after 180s! Status: $status";
        say "=== Service Status ===";
        my $full_status = run "systemctl status rke2-server.service --no-pager || true";
        say $full_status;
        say "=== Journal Logs (last 50 lines) ===";
        my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
        say $journal;
        say "=== End Logs ===";
        die "RKE2 server failed to start";
    }

    # Wait for kubeconfig to exist (max 60s)
    say "[5/5] Waiting for Kubernetes to initialize...";
    run "timeout 60 bash -c 'while [ ! -f /etc/rancher/rke2/rke2.yaml ]; do sleep 2; done' || true";

    # Check if it exists now
    my $check = run "test -f /etc/rancher/rke2/rke2.yaml && echo EXISTS || echo MISSING", auto_die => FALSE;
    chomp $check;

    if ($check ne 'EXISTS') {
        say "ERROR: kubeconfig not found after 60s!";
        say "=== Directory listing ===";
        my $ls = run "ls -la /etc/rancher/rke2/ || true";
        say $ls;
        say "=== Journal Logs ===";
        my $journal = run "journalctl -u rke2-server.service -n 100 --no-pager";
        say $journal;
        die "RKE2 kubeconfig not created";
    }

    # Wait for API to respond
    run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 5; done", timeout => 300;

    say "✓ RKE2 cluster ready";

    # Return kubeconfig and token for OCP to store
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    say "KUBECONFIG_START";
    say $kubeconfig;
    say "KUBECONFIG_END";
    say "TOKEN: $token";
};

desc "Install RKE2 agent (worker)";
task "install_rke2_agent", sub {
    my $params = shift;
    my $server = $params->{server} or die "server URL required";
    my $token = $params->{token} or die "token required";
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Create RKE2 agent config
    my $config = "server: $server\ntoken: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;

    file "/etc/rancher/rke2", ensure => 'directory';
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Install RKE2 agent
    my $install_cmd = "curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE=agent ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$version " if $version;
    $install_cmd .= "sh -";

    run $install_cmd;

    # Start service
    run "systemctl enable rke2-agent.service";
    run "systemctl start rke2-agent.service";

    say "RKE2 agent joined cluster";
};

desc "Get RKE2 kubeconfig";
task "get_rke2_kubeconfig", sub {
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    return $kubeconfig;
};

desc "Get RKE2 token";
task "get_rke2_token", sub {
    my $token = run "cat /var/lib/rancher/rke2/server/node-token";
    chomp $token;
    return $token;
};

