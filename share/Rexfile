# OCP Rexfile - Server Automation Tasks
use Rex -feature => ['1.4'];
use Rex::Commands::Run;
use Rex::Commands::Fs;
use Rex::Commands::File;
use Rex::Commands::Service;
use Rex::Commands::Pkg;

# Authentication
set connection => 'SSH';
parallelism 1;

# SSH options - disable strict host key checking
set ssh_config_options => {
    StrictHostKeyChecking => 'no',
    UserKnownHostsFile    => '/dev/null',
};

# SSH config from environment
if ($ENV{REX_PRIVATE_KEY}) {
    private_key $ENV{REX_PRIVATE_KEY};
    public_key $ENV{REX_PUBLIC_KEY} if $ENV{REX_PUBLIC_KEY};
    key_auth;
}

# Helper: Check OS compatibility
sub check_os {
    my $os = operating_system();
    my $version = operating_system_version();

    say "Detected OS: $os $version";

    # We support Debian-based systems (Debian, Ubuntu)
    unless ($os eq 'Debian' || $os eq 'Ubuntu') {
        say "WARNING: This OS ($os) is not officially tested.";
        say "OCP is designed for Debian/Ubuntu. Proceed with caution.";
    }
}

#
# Common Tasks
#

desc "Prepare node for Kubernetes";
task "prepare_node", sub {
    # Check OS compatibility
    check_os();

    # Ensure required packages are installed
    pkg ["curl", "ca-certificates"], ensure => "present";

    # Disable swap
    run "swapoff -a || true";
    run "sed -i '/swap/d' /etc/fstab || true";

    # Load kernel modules
    run "modprobe br_netfilter || true";
    run "modprobe overlay || true";

    file "/etc/modules-load.d/kubernetes.conf",
        content => "br_netfilter\noverlay\n";

    # Sysctl settings
    file "/etc/sysctl.d/99-kubernetes.conf",
        content => "net.bridge.bridge-nf-call-iptables = 1\nnet.bridge.bridge-nf-call-ip6tables = 1\nnet.ipv4.ip_forward = 1\n";

    run "sysctl --system > /dev/null 2>&1";
};

desc "Detect GPU and install drivers";
task "detect_gpu", sub {
    # Ensure lspci is available
    my $has_lspci = run "command -v lspci >/dev/null 2>&1 && echo yes || echo no", auto_die => FALSE;
    chomp $has_lspci;

    if ($has_lspci ne 'yes') {
        say "lspci not found, installing pciutils...";
        pkg ["pciutils"], ensure => "present";
    }

    # Get full lspci output for debugging
    my $lspci_output = run "lspci 2>&1", auto_die => FALSE;
    say "=== PCI Devices ===";
    say $lspci_output;
    say "=== End PCI Devices ===";

    # Check for NVIDIA
    my $has_nvidia = run "lspci | grep -i nvidia", auto_die => FALSE;
    my $nvidia_found = ($? == 0 && $has_nvidia);

    # Check for AMD (Radeon, RX, VGA with AMD/ATI)
    my $has_amd = run "lspci | grep -iE '(vga|display|3d).*(amd|ati|radeon)'", auto_die => FALSE;
    my $amd_found = ($? == 0 && $has_amd);

    say "GPU Detection Results:";
    say "  NVIDIA: " . ($nvidia_found ? "YES" : "no");
    say "  AMD: " . ($amd_found ? "YES" : "no");

    if ($nvidia_found) {
        say "Installing NVIDIA drivers...";

        # Detect provider
        my $is_hetzner = run "curl -s http://169.254.169.254/hetzner/v1/metadata 2>/dev/null", auto_die => FALSE;

        if ($? == 0) {
            say "Hetzner Cloud detected";
            do_task "install_nvidia_hetzner";
        } else {
            say "Bare metal NVIDIA GPU server";
            do_task "install_nvidia_generic";
        }
    } elsif ($amd_found) {
        say "Installing AMD GPU drivers and ROCm...";
        do_task "install_amd_gpu";
    } else {
        say "No GPU detected, skipping driver installation";
    }
};

desc "Install NVIDIA drivers on Hetzner";
task "install_nvidia_hetzner", sub {
    # Hetzner-specific NVIDIA installation
    update_package_db;

    my $packages = case operating_system,
        Debian => ["linux-headers-amd64", "nvidia-driver", "nvidia-kernel-dkms"],
        Ubuntu => ["linux-headers-generic", "nvidia-driver-535"];

    pkg $packages, ensure => "present";
    run "modprobe nvidia";
};

desc "Install AMD GPU drivers and ROCm";
task "install_amd_gpu", sub {
    say "Installing AMD GPU drivers and ROCm...";

    # Ensure dependencies
    pkg ["curl", "gnupg", "wget"], ensure => "present";
    update_package_db;

    # Determine AMD repo URL based on OS
    my $os = operating_system();
    my $version = operating_system_version();
    my ($repo_os, $repo_dist);

    if ($os eq 'Debian') {
        $repo_os = 'debian';
        # Debian 12 = bookworm, 13 = trixie
        $repo_dist = $version >= 13 ? 'trixie' : 'bookworm';
    } elsif ($os eq 'Ubuntu') {
        $repo_os = 'ubuntu';
        # Map Ubuntu version to codename
        $repo_dist = $version =~ /^24/ ? 'noble' :
                     $version =~ /^22/ ? 'jammy' :
                     $version =~ /^20/ ? 'focal' : 'jammy';
    } else {
        die "Unsupported OS for AMD GPU: $os";
    }

    say "Detected OS: $os $version -> repo: $repo_os/$repo_dist";

    # Download and install amdgpu-install tool
    my $installer_url = "https://repo.radeon.com/amdgpu-install/6.4.1/$repo_os/$repo_dist/amdgpu-install_6.4.60401-1_all.deb";

    say "Downloading AMD GPU installer from $installer_url";
    run "wget -O /tmp/amdgpu-install.deb $installer_url";

    say "Installing amdgpu-install tool...";
    run "apt install -y /tmp/amdgpu-install.deb";
    run "rm /tmp/amdgpu-install.deb";

    # Refresh repositories
    update_package_db;

    # Install ROCm stack (for ML/compute workloads on Kubernetes)
    say "Installing ROCm stack...";
    run "amdgpu-install -y --usecase=rocm --no-dkms";

    # Load amdgpu module
    run "modprobe amdgpu";

    say "AMD GPU drivers and ROCm installed";
};

desc "Install NVIDIA drivers generic";
task "install_nvidia_generic", sub {
    # Ensure curl and gpg are installed
    pkg ["curl", "gnupg"], ensure => "present";

    update_package_db;

    my $headers = case operating_system,
        Debian => ["linux-headers-amd64"],
        Ubuntu => ["linux-headers-generic"];

    pkg $headers, ensure => "present";

    # Add NVIDIA repo (Debian/Ubuntu specific)
    run "curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg";
    run "curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' > /etc/apt/sources.list.d/nvidia-container-toolkit.list";

    update_package_db;

    my $nvidia_packages = case operating_system,
        Debian => ["nvidia-driver", "nvidia-container-toolkit"],
        Ubuntu => ["nvidia-driver-535", "nvidia-container-toolkit"];

    pkg $nvidia_packages, ensure => "present";
    run "modprobe nvidia";
};

#
# RKE2 Tasks
#

desc "Install RKE2 server (control plane)";
task "install_rke2_server", sub {
    my $params = shift;
    my $token = $params->{token} || _generate_token();
    my $version = $params->{version} || '';
    my $tls_san = $params->{tls_san} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Create RKE2 config
    my $config = "cni: none\ndisable-kube-proxy: true\n";
    $config .= "token: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;
    $config .= "tls-san:\n  - $tls_san\n" if $tls_san;
    $config .= "disable:\n  - rke2-ingress-nginx\n";

    run "mkdir -p /etc/rancher/rke2";
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Install RKE2
    say "[1/5] Installing RKE2...";
    my $install_cmd = "curl -sfL https://get.rke2.io | ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$version " if $version;
    $install_cmd .= "sh -";

    my $install_result = run $install_cmd, auto_die => FALSE;

    if ($? != 0) {
        say "ERROR: RKE2 installation failed!";
        say "=== Install Output ===";
        say $install_result;
        say "=== End Install Output ===";
        die "RKE2 install script failed";
    }

    # Verify installation - binary is called 'rke2', not 'rke2-server'
    say "[2/5] Verifying RKE2 binary...";
    my $rke2_bin = run "test -f /usr/local/bin/rke2 && echo OK || echo MISSING", auto_die => FALSE;
    chomp $rke2_bin;

    if ($rke2_bin ne 'OK') {
        say "ERROR: RKE2 binary not found at /usr/local/bin/rke2!";
        say "=== Searching for RKE2 files ===";
        my $search = run "ls -la /usr/local/bin/rke2* 2>&1 || true";
        say $search;
        die "RKE2 binary missing";
    }

    # Start service
    say "[3/5] Enabling and starting RKE2 service...";
    run "systemctl enable rke2-server.service 2>&1", auto_die => FALSE;
    run "systemctl start rke2-server.service 2>&1", auto_die => FALSE;

    # Check if service started
    say "[4/5] Checking service status...";
    my $status = run "systemctl is-active rke2-server.service", auto_die => FALSE;
    chomp $status;

    if ($status !~ /^active/) {
        say "ERROR: rke2-server.service is not active! Status: $status";
        say "=== Service Status ===";
        my $full_status = run "systemctl status rke2-server.service --no-pager || true";
        say $full_status;
        say "=== Journal Logs (last 50 lines) ===";
        my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
        say $journal;
        say "=== End Logs ===";
        die "RKE2 server failed to start";
    }

    # Wait for kubeconfig to exist (max 60s)
    say "[5/5] Waiting for Kubernetes to initialize...";
    run "timeout 60 bash -c 'while [ ! -f /etc/rancher/rke2/rke2.yaml ]; do sleep 2; done' || true";

    # Check if it exists now
    my $check = run "test -f /etc/rancher/rke2/rke2.yaml && echo EXISTS || echo MISSING", auto_die => FALSE;
    chomp $check;

    if ($check ne 'EXISTS') {
        say "ERROR: kubeconfig not found after 60s!";
        say "=== Directory listing ===";
        my $ls = run "ls -la /etc/rancher/rke2/ || true";
        say $ls;
        say "=== Journal Logs ===";
        my $journal = run "journalctl -u rke2-server.service -n 100 --no-pager";
        say $journal;
        die "RKE2 kubeconfig not created";
    }

    # Wait for API to respond
    run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 5; done", timeout => 300;

    say "✓ RKE2 cluster ready";

    # Return kubeconfig and token for OCP to store
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    say "KUBECONFIG_START";
    say $kubeconfig;
    say "KUBECONFIG_END";
    say "TOKEN: $token";
};

desc "Install RKE2 agent (worker)";
task "install_rke2_agent", sub {
    my $params = shift;
    my $server = $params->{server} or die "server URL required";
    my $token = $params->{token} or die "token required";
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Create RKE2 agent config
    my $config = "server: $server\ntoken: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;

    run "mkdir -p /etc/rancher/rke2";
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Install RKE2 agent
    my $install_cmd = "curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE=agent ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$version " if $version;
    $install_cmd .= "sh -";

    run $install_cmd;

    # Start service
    run "systemctl enable rke2-agent.service";
    run "systemctl start rke2-agent.service";

    say "RKE2 agent joined cluster";
};

desc "Get RKE2 kubeconfig";
task "get_rke2_kubeconfig", sub {
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    return $kubeconfig;
};

desc "Get RKE2 token";
task "get_rke2_token", sub {
    my $token = run "cat /var/lib/rancher/rke2/server/node-token";
    chomp $token;
    return $token;
};

#
# K3s Tasks
#

desc "Install K3s server (control plane)";
task "install_k3s_server", sub {
    my $params = shift;
    my $token = $params->{token} || _generate_token();
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Install K3s
    my $install_cmd = "curl -sfL https://get.k3s.io | ";
    $install_cmd .= "INSTALL_K3S_VERSION=$version " if $version;
    $install_cmd .= "K3S_TOKEN=$token ";
    $install_cmd .= "K3S_NODE_NAME=$node_name " if $node_name;
    $install_cmd .= "sh -s - server --disable=traefik --disable=servicelb --write-kubeconfig-mode=644";

    run $install_cmd;

    # Wait for ready
    say "Waiting for K3s to be ready...";
    run "while ! kubectl get nodes 2>/dev/null; do sleep 5; done", timeout => 300;

    say "K3s server ready";
};

desc "Install K3s agent (worker)";
task "install_k3s_agent", sub {
    my $params = shift;
    my $server = $params->{server} or die "server URL required";
    my $token = $params->{token} or die "token required";
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Install K3s agent
    my $install_cmd = "curl -sfL https://get.k3s.io | ";
    $install_cmd .= "INSTALL_K3S_VERSION=$version " if $version;
    $install_cmd .= "K3S_URL=$server K3S_TOKEN=$token ";
    $install_cmd .= "K3S_NODE_NAME=$node_name " if $node_name;
    $install_cmd .= "sh -s - agent";

    run $install_cmd;

    say "K3s agent joined cluster";
};

desc "Get K3s kubeconfig";
task "get_k3s_kubeconfig", sub {
    my $kubeconfig = run "cat /etc/rancher/k3s/k3s.yaml";
    return $kubeconfig;
};

desc "Get K3s token";
task "get_k3s_token", sub {
    my $token = run "cat /var/lib/rancher/k3s/server/node-token";
    chomp $token;
    return $token;
};

#
# Single-Node Tasks
#

desc "Untaint control plane (allow workloads)";
task "untaint_control_plane", sub {
    my $params = shift;
    my $distribution = $params->{distribution} || 'rke2';

    say "Removing control plane taints...";

    if ($distribution eq 'rke2') {
        # Wait for node to be registered
        run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 2; done", timeout => 60;

        # Get node name
        my $node = run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath='{.items[0].metadata.name}'";
        chomp $node;

        # Remove taints
        run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml taint nodes $node node-role.kubernetes.io/control-plane:NoSchedule- || true";
        run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml taint nodes $node node-role.kubernetes.io/master:NoSchedule- || true";
    } else {
        # K3s
        run "while ! kubectl get nodes 2>/dev/null; do sleep 2; done", timeout => 60;

        my $node = run "kubectl get nodes -o jsonpath='{.items[0].metadata.name}'";
        chomp $node;

        run "kubectl taint nodes $node node-role.kubernetes.io/control-plane:NoSchedule- || true";
        run "kubectl taint nodes $node node-role.kubernetes.io/master:NoSchedule- || true";
    }

    say "Control plane untainted, workloads can be scheduled";
};

#
# Helpers
#

sub _generate_token {
    my $token = run "head -c 48 /dev/urandom | base64 | tr -d '\\n+/='";
    chomp $token;
    return substr($token, 0, 48);
}

#
# Cilium Tasks
#

desc "Install Cilium CNI";
task "install_cilium", sub {
    my $params = shift;
    my $distribution = $params->{distribution} || 'rke2';

    say "Installing Cilium CNI...";

    # Determine kubectl path
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';
    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';

    # Install Cilium CLI
    say "Installing Cilium CLI...";
    run "curl -sfL https://github.com/cilium/cilium-cli/releases/latest/download/cilium-linux-amd64.tar.gz | tar xz -C /usr/local/bin";
    run "chmod +x /usr/local/bin/cilium";

    # Install Cilium
    say "Installing Cilium into cluster...";
    my $cilium_install = "KUBECONFIG=$kubeconfig cilium install --version 1.17.0";
    run $cilium_install;

    # Wait for Cilium to be ready
    say "Waiting for Cilium to be ready...";
    run "KUBECONFIG=$kubeconfig cilium status --wait --wait-duration=5m", timeout => 360;

    say "Cilium installed successfully";
};

1;
