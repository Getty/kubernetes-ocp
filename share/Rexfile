# A control plane: the first server (cluster-init), or with `server` another
# one joining its embedded etcd (k8, RKE2 only -- OCP::Node refuses a k3s one).
#
# What Rex::Rancher::Server::install_server guarantees, and OCP relies on:
#   - the token goes into config.yaml only, never onto the installer line or
#     into its environment, and config.yaml is 0600 root:root (k156);
#   - without a token it reuses the one the server is already sealed with
#     (/var/lib/rancher/<dist>/server/token) and only mints one for a fresh
#     server -- a rotated token arms a fatal "bootstrap data already found and
#     encrypted with different token" on the next restart (k150, k154). OCP::Rex
#     always passes one; a bare hand-run passes none;
#   - Cilium is the only CNI: rke2 gets cni: none + disable-kube-proxy, k3s
#     flannel-backend: none, disable-network-policy, disable-kube-proxy (k178);
#     the bundled ingress (rke2-ingress-nginx, rke2-traefik(-crd); k3s traefik,
#     servicelb) is disabled by its default list;
#   - every tls-san entry lands in config.yaml, one per address, so TLS holds
#     against every server of an HA cluster (k137);
#   - cluster_cidr lands in config.yaml as cluster-cidr on rke2 and k3s alike
#     (rex-rancher k41), and anything but one IPv4 CIDR dies before the host is
#     touched;
#   - a running rke2 server is restarted when its config.yaml(.d),
#     registries.yaml or /etc/default file changed since it started, and only
#     then (rex-rancher k49); k3s is restarted on every run;
#   - a bare containerd config.toml.tmpl -- only `imports` and `version = 2`,
#     what OCP before k23 wrote -- is removed right before the service is
#     (re)started, and a running service whose config.toml is still its output
#     is restarted once; any other template stays (rex-rancher k72). The same
#     holds for install_agent;
#   - the service is started with --no-block and waited on for at most 10
#     minutes, dying with its journal; a pinned version is verified against the
#     installed binary;
#   - with hold_running (rex-rancher k77, k193) a server that is there keeps
#     its version: see _server_opts.
#
# RKE2 comes from its checksum-verified release tarball when a version is
# pinned (always, through OCP::Rex and OCP::Node): the old reason for the
# pre-download was that the install script's silent `curl -s` looked like a
# hung channel. K3s keeps the install script, as before.
sub _install_server {
    my ($distribution, $params) = @_;

    # tls-san arrives as a JSON array (the list OCP::Rex/OCP::Node build) or,
    # for a hand-run `rex ... --tls_san=1.2.3.4`, as a bare scalar.
    my $tls_san = $params->{tls_san};
    my @tls_sans = ref $tls_san eq 'ARRAY' ? @$tls_san
                 : (defined $tls_san && length $tls_san) ? ($tls_san)
                 : ();

    # One set of options, for the checks up front and for the install.
    my %opts = (
        _server_opts($distribution, $params, \@tls_sans),
        cluster_cidr => $params->{pod_cidr} || _default_pod_cidr(),
    );

    # Everything install_server would refuse, asked before prepare_node
    # changes the host, so a refused host is left exactly as it was
    # (rex-rancher k78). install_server asks the same again, first thing --
    # its log lines appear twice. Read-only:
    #   - Cilium datapath state from a previous cluster on a host without
    #     RKE2/K3s (k190, rex-rancher k71): an uninstall that left Cilium's eBPF
    #     behind leaves the socket load balancer translating the old cluster's
    #     service addresses to pods that are gone, so connections hang instead
    #     of being refused -- the registry mirror containerd pulls through
    #     (localhost:30500) among them, and RKE2 misses its start bound without
    #     saying why. Measured on ocpt-cp; the refusal asks for a reboot;
    #   - the version to hold (hold_running) and its skew against the running
    #     server or installed binary;
    #   - the cluster-cidr of a server already set up here (rex-rancher k67).
    Rex::Rancher::Server::preflight_server(%opts);

    do_task "prepare_node", _node_params($params);
    _maybe_detect_gpu($params);

    Rex::Rancher::Server::install_server(%opts);

    # Only now that config.yaml carries cluster-cidr itself.
    _remove_legacy_cluster_cidr_dropin($distribution, $opts{cluster_cidr});

    _wait_for_api($distribution);
}

# The install_server options for OCP's task parameters. Empty values become
# undef, never '': the library takes a defined token as given, and an empty
# one would be written into config.yaml instead of the sealed one being reused.
sub _server_opts {
    my ($distribution, $params, $tls_sans) = @_;
    my $version = $params->{version} || undef;

    return (
        distribution        => $distribution,
        token               => $params->{token}     || undef,
        # Join an existing embedded-etcd cluster (k8). Like the token it arrives
        # through REX_TASK_PARAMS, never on a command line.
        server              => $params->{server}    || undef,
        node_name           => $params->{node_name} || undef,
        version             => $version,
        install_method      => ($distribution eq 'rke2' && $version ? 'artifact' : 'script'),
        (@$tls_sans ? (tls_san => [ @$tls_sans ]) : ()),
        # K3s never got registry mirrors from OCP; that stays as it was.
        ($distribution eq 'rke2' ? (registries => _registries($params)) : ()),
        # RKE2's unit sets no PATH, and it looks for the NVIDIA runtime only when
        # the service starts: /etc/default/rke2-server gets one, before the
        # install, if a host toolkit is there. No effect on k3s.
        nvidia_runtime_path => 1,
        # OCP installs a distribution; it never upgrades one (k193, rex-rancher
        # k77). The version on the host wins over the pin: a running server
        # keeps the version it runs, a stopped one the installed binary's, and
        # only a host with neither gets `version`. A pin that loses is named in
        # a warning, on every run that meets it. The service is restarted only
        # for a changed configuration, k3s included. A new node -- every robocop
        # join, every fresh bootstrap -- has nothing to hold and gets the pin.
        # So a bootstrap run against a control plane that is already there (a
        # lost kubeconfig.yaml) neither rolls it to a new pin nor refuses it for
        # having been upgraded by hand: distribution upgrades stay what
        # OCP::Drift reports them as, a manual step, node by node.
        hold_running        => 1,
    );
}

#
# Helpers
#

# A worker joining the cluster at `server` with the node token.
#
# Rex::Rancher::Agent::install_agent writes server + token into config.yaml
# only (0600, k156), starts the unit with --no-block and waits at most 10
# minutes for it to turn active, dying with its journal (k185: a Type=notify
# agent that cannot reach its server used to hang the task and `ocp apply`
# with it). The message names the server the agent joins through, the
# likeliest reason it never gets there (rex-rancher k44).
#
# With `kubeconfig` -- a kubeconfig of the cluster, as a file on this machine
# -- install_agent first reads the control plane's version through the API and
# refuses an agent of a newer minor before the host is touched: a kubelet must
# never be newer than its API server (k196). OCP::Node passes one when its
# caller has it (`ocp apply`, `ocp node add`); robocop runs off its service
# account and has no kubeconfig file, so its joins go without the check.
#
# With hold_running an agent that is there keeps its own version, as a server
# does (see _server_opts); the check against the control plane still applies
# to the version held.
sub _install_agent {
    my ($distribution, $params) = @_;
    $params->{server} or die "server URL required\n";
    $params->{token}  or die "token required\n";

    my %opts = _agent_opts($distribution, $params);

    # Everything install_agent would refuse, before prepare_node touches the
    # host (rex-rancher k78), as for a server (see _install_server): the Cilium
    # leftovers (k190), the version to hold and its skew, and with
    # `kubeconfig` the control plane's version, read through the API.
    # install_agent asks again, first thing.
    Rex::Rancher::Agent::preflight_agent(%opts);

    do_task "prepare_node", _node_params($params);
    _maybe_detect_gpu($params);

    Rex::Rancher::Agent::install_agent(%opts);
}

sub _agent_opts {
    my ($distribution, $params) = @_;
    return (
        distribution        => $distribution,
        server              => $params->{server},
        token               => $params->{token},
        version             => $params->{version}   || undef,
        node_name           => $params->{node_name} || undef,
        ($distribution eq 'rke2' ? (registries => _registries($params)) : ()),
        nvidia_runtime_path => 1,
        ($params->{kubeconfig} ? (kubeconfig => $params->{kubeconfig}) : ()),
        hold_running        => 1,
    );
}

# The pod network, stated on both sides: the server's cluster-cidr and
# Cilium's cluster-pool IPAM must agree, and Cilium's own default (10.0.0.0/8)
# neither does nor stays clear of host LANs (k178, k182). OCP::Rex passes
# network.pod_cidr from ocp.yaml as pod_cidr; this is the fallback for
# hand-runs and for robocop's control-plane joins, which never see ocp.yaml.
# Same value as $OCP::Config::DEFAULT_POD_CIDR (t/182 holds them together),
# and the built-in cluster-cidr of RKE2 and k3s alike.
sub _default_pod_cidr { '10.42.0.0/16' }

# The config.yaml.d drop-in OCP wrote cluster-cidr to while Rex::Rancher had
# no option for it (up to 0.002, rex-rancher k41). install_server now writes
# cluster-cidr into config.yaml itself; the drop-in, read after config.yaml,
# would keep overriding it on every node set up before.
#
# Removed by content, like the legacy containerd template: only a file that
# says exactly `cluster-cidr: <the value passed now>` goes -- it states nothing
# config.yaml does not, so nothing changes for the server. Any other content
# is not left over but in force: a cluster's cluster-cidr cannot change, and
# a drop-in that disagrees is what the server runs on, so it stays and says so.
#
# Removed only after install_server returned, when config.yaml says the same
# cluster-cidr. Before it, a failed install_server -- its version-skew check
# dies before config.yaml is written -- would leave a config.yaml from before
# 0.003 with no cluster-cidr and no drop-in, and the next start of the server
# (a reboot) would run the distribution's default instead of pod_cidr. The
# price: the removal changes config.yaml.d after the server (re)started, so
# the next run's install_server restarts a running rke2 server once more
# (rex-rancher k49 watches config.yaml.d by mtime). k3s restarts on every run
# anyway.
sub _legacy_cluster_cidr_dropin {
    my ($distribution) = @_;
    return "/etc/rancher/$distribution/config.yaml.d/50-ocp-cluster-cidr.yaml";
}

sub _remove_legacy_cluster_cidr_dropin {
    my ($distribution, $cidr) = @_;
    my $path = _legacy_cluster_cidr_dropin($distribution);
    return 0 unless is_file($path);

    my $content = eval { cat $path } // '';
    my ($stated) = $content =~ /\A\s*cluster-cidr:\s*(\S+)\s*\z/;
    unless (defined $stated && $stated eq $cidr) {
        say "Keeping $path: it does not say cluster-cidr: $cidr, and as a drop-in it "
          . "overrides the cluster-cidr in config.yaml -- the cluster runs on what it says";
        return 0;
    }

    unlink $path;
    say "Removed $path: config.yaml carries cluster-cidr $cidr itself now";
    return 1;
}

# registries.yaml as Rex::Rancher takes it: docker.io through ocp-cache, the
# internal registry under both of its names through ocp-registry. External
# endpoints from ocp.yaml replace the NodePorts.
sub _registries {
    my ($params) = @_;
    my $cache_endpoint    = $params->{registry_cache}    || 'http://localhost:30500';
    my $upstream_endpoint = $params->{registry_upstream} || 'http://localhost:30501';
    my $registry_name     = $params->{registry_name}     || 'ocp.internal';

    return {
        mirrors => {
            'docker.io'      => { endpoint => [$cache_endpoint] },
            'registry.local' => { endpoint => [$upstream_endpoint] },
            $registry_name   => { endpoint => [$upstream_endpoint] },
        },
    };
}

# Waits for the API server to answer, and dies when it does not.
# install_server returns once the service is active and the kubeconfig
# written; everything after this (Cilium, the kubeconfig OCP fetches) needs
# the API itself.
#
# Asked from this machine through Kubernetes::REST, not with kubectl on the
# node (k196): Rex::Rancher::K8s::wait_for_api lists the Nodes every 5 seconds
# for 5 minutes, through the node's admin kubeconfig pointed at the address
# Rex reaches the node on -- the route install_cilium takes right after, and
# the one Rex::Rancher's own server deploy waits on. The library returns false
# on a timeout instead of dying, so the dying is done here.
sub _wait_for_api {
    my ($distribution) = @_;
    my $local = _local_kubeconfig($distribution);

    return 1 if Rex::Rancher::K8s::wait_for_api(kubeconfig => "$local");

    my $host = "" . connection->server;
    die "The Kubernetes API of $distribution on $host did not answer within 5 minutes,\n"
      . "asked from this machine through the node's admin kubeconfig.\n"
      . "Check that $distribution runs on the node and that this machine reaches $host:6443.\n";
}

# The bare containerd config template OCP wrote before k23.
#
# _configure_nvidia_containerd wrote two lines (56 bytes: an imports line and
# `version = 2`) to /var/lib/rancher/rke2/agent/etc/containerd/config.toml.tmpl.
# k23 deleted the code, not the file. RKE2 and k3s render config.toml from such
# a template on every service start, *instead of* the config they generate
# themselves, so a host bootstrapped before that fix keeps running containerd
# off this two-liner forever -- no registry mirrors, no sandbox image, no CNI
# settings -- and upgrading OCP does not help, because the damage is a file and
# not code. Measured on cortex (k45).
#
# `ocp destroy` takes /var/lib/rancher with it, and every install through
# Rex::Rancher removes the template before the service starts (rex-rancher
# k72), so the host this matters for is the one that gets bootstrapped once and
# only ever upgraded afterwards: `ocp apply` against a running cluster installs
# nothing. That is what the probe and the drift remedy below are for.
#
# What counts as that template is Rex::Rancher's decision, the one its installs
# remove by: Rex::Rancher::Distribution's is_bare_template_output -- blank lines
# and comments aside, exactly an `imports =` and a `version = 2` line (Rex::GPU
# 0.001 wrote the same). Decided by content, never by path: any other template,
# `{{ template "base" . }}` and all, is somebody's configuration and stays.
# Both distributions: only the RKE2 path was ever written by OCP, but k3s
# renders a template it finds in exactly the same way.
sub _distributions {
    my $classes = Rex::Rancher::Distribution->distribution_classes;
    return map { Rex::Rancher::Distribution->new_for($_) } sort keys %$classes;
}

# Read-only counterpart of cleanup_legacy_containerd_template: it reports the
# template without touching it, so OCP::Drift's rex_probe mode can run it on
# `ocp status` (which must never modify a host). One "OCP-DRIFT-PRESENT <path>"
# line per bare template present; silence means clean. Read with `cat` over
# the exec channel, as the library reads it. The marker string is the one
# OCP::Drift matches ($OCP::Drift::REX_DRIFT_MARKER) -- keep the two in step.
desc "Report whether the obsolete pre-k23 containerd config template is still present (read-only)";
task "detect_legacy_containerd_template", sub {
    for my $dist (_distributions()) {
        my $tmpl = $dist->containerd_dir . '/config.toml.tmpl';
        my $content = run "cat $tmpl 2>/dev/null", auto_die => FALSE;
        next unless $? == 0;
        next unless $dist->is_bare_template_output($content);
        say "OCP-DRIFT-PRESENT $tmpl";
    }
};

# OCP::Drift's remedy for what the probe above reports: Rex::Rancher's
# remove_bare_containerd_template, per distribution, which removes it by the
# same decision the probe reports it by (and keeps any other template, saying
# so), and dies naming the file when the removal fails. The installs do not
# run it: install_server and install_agent remove the template themselves,
# before the start.
#
# It restarts nothing: containerd keeps running on its config.toml until the
# service starts again, which then renders the distribution's own config. A
# public "remove and restart the running service once" is not in the library
# (rex-rancher board, from k196).
desc "Remove the obsolete containerd config template OCP wrote before k23";
task "cleanup_legacy_containerd_template", sub {
    for my $dist (_distributions()) {
        next unless $dist->remove_bare_containerd_template;
        say "Removed the bare containerd template in " . $dist->containerd_dir
          . " -- the next start of " . $dist->label . " renders its own containerd config again";
    }
};

#
# Cilium Tasks
#

# Every Cilium version flows in from OCP::Versions via the task parameter
# JSON (REX_TASK_PARAMS, set by OCP::Rex::install_server) or, for hand-runs,
# from an explicit OCP_*_VERSION environment variable. There are no
# constants in this file because every pin lives exactly once, in
# OCP::Versions (ADR 0014): duplicating the pin here is how the install
# ran against an older Cilium and OCP::Drift reported drift against the
# distribution's own manifest on the next status call.
#
# Gateway API is version-locked to Cilium: 1.20 requires the CRDs from
# v1.6.1, because it demands tlsroutes/referencegrants/backendtlspolicies
# at gateway.networking.k8s.io/v1. Older bundles serve those as v1alpha2
# or v1beta1, and the operator then refuses to start its Gateway
# controller at all — Gateway and GatewayClass sit at Accepted=Unknown.
# Bumping the pin means bumping both together.
#
# install_cilium, upgrade_cilium and update_gateway_api go through
# Rex::Rancher::Cilium. It talks to the API from this machine, through a
# kubeconfig _local_kubeconfig fetches from the node, and it:
#   - reads the Helm release (install, upgrade, purge a stale release, or
#     nothing);
#   - reads what a running Cilium uses before anything touches the node -- IPAM
#     mode and pool from kube-system/cilium-config, on k3s the API server
#     address from the cilium DaemonSet, the operator's replicas -- and keeps
#     it (k182); an API error other than a 404 there dies instead of falling
#     back to a default;
#   - applies the Gateway API CRDs before Cilium and dies when that fails, and
#     skips them when the cluster already carries the bundle version and
#     channel (the same annotations OCP::Drift reads, k164);
#   - with wait, returns only once the cilium DaemonSet and cilium-operator are
#     rolled out and ready, and dies naming their state otherwise (k178: a
#     Cilium that never became ready used to cost the full wait and then report
#     success).

# Gateway API CRDs come from exactly one channel: standard. Never both, and
# never experimental on top of standard -- from Gateway API v1.5 both bundles
# ship the ValidatingAdmissionPolicy safe-upgrades.gateway.networking.k8s.io,
# which refuses experimental CRDs over standard ones (standard over
# experimental stays allowed). OCP used to apply standard and then
# experimental with auto_die off; under the v1.6.1 pin the second apply was
# denied and nobody noticed (k157). Rex::Rancher defaults to experimental, so
# the channel is always passed.
#
# Standard is enough: from v1.5 it carries TLSRoute v1 and BackendTLSPolicy
# v1, which Cilium 1.20 requires, and from v1.6 TCPRoute and UDPRoute too.
# It is also the only channel every existing OCP cluster re-applies cleanly:
# clusters installed under the v1.6.1 pin are standard already (experimental
# was refused), older ones on experimental may move to standard. Switching a
# cluster to experimental means deleting the safe-upgrades policy by hand --
# and the next `ocp apply` of this task moves it back to standard.
sub _gateway_api_channel { 'standard' }

# The Rex::Rancher::Cilium options for OCP.
#
# The IPAM mode is ipam_mode cluster-pool (rex-rancher k64): the mode of a
# fresh install, which every OCP cluster has run since before k155 (the
# chart's default then). Rex::Rancher's rke2 default is ipam.mode kubernetes,
# so a fresh RKE2 cluster would get that without it. Like cluster_cidr for the
# pool, it gives way to a running Cilium: one in another mode keeps its mode
# and pool, and the library warns instead of dying (Cilium cannot change the
# mode under running pods) -- as OCP up to 0.002 read the running mode and
# kept it. Not ipam.mode in helm_values: that is a demand, and against a
# running Cilium in any other mode the library dies before the node is
# touched, on every `ocp apply`.
#
# The pool is not stated: cluster_cidr is the pool of a fresh install only, a
# running cluster-pool keeps its own (k182, with a warning when it differs --
# an RKE2 cluster from before k182 runs 10.0.0.0/8, which OCP::Drift reports).
#
# k3s needs the control plane's address for kube-proxy replacement: its agents
# serve the API on 127.0.0.1:6444, so no localhost port works on every node
# (k178). Without one the library takes the running Cilium's and dies when
# there is none, before the node is touched. RKE2 must not get one --
# Rex::Rancher uses 127.0.0.1:6443 there, which RKE2 servers and agents both
# serve, and refuses the option.
sub _cilium_opts {
    my (%o) = @_;
    my $distribution = $o{distribution} || 'rke2';
    my $host = $o{k8s_service_host};

    return (
        distribution        => $distribution,
        version             => $o{version},
        cli_version         => $o{cli_version},
        kubeconfig          => $o{kubeconfig},
        gateway_api         => 1,
        gateway_api_version => $o{gateway_api_version},
        gateway_api_channel => _gateway_api_channel(),
        ipam_mode           => 'cluster-pool',
        (defined $o{cluster_cidr} ? (cluster_cidr => $o{cluster_cidr}) : ()),
        ($distribution eq 'k3s' && defined $host && length $host
            ? (k8s_service_host => $host) : ()),
        wait                => 1,
        wait_duration       => $o{wait_duration},
    );
}

# A kubeconfig on this machine for the cluster on the node Rex is connected
# to, as a File::Temp object (gone when it goes out of scope).
#
# Rex::Rancher::Cilium reads the Helm release and applies the Gateway API
# CRDs through Kubernetes::REST, from here, and Rex::Rancher::K8s waits for
# the API after a server install the same way. Rex::Rancher::Server's
# fetch_kubeconfig (rex-rancher k73) reads the admin kubeconfig off the node,
# points its server at the address Rex reaches the node on -- the one OCP::Rex
# connects to, which is where OCP reaches the API as well; the library takes
# none on its own --, applies OCP's policy and writes the file 0600. It dies
# naming the distribution when the node has no kubeconfig.
sub _local_kubeconfig {
    my ($distribution) = @_;

    my $fh = File::Temp->new(TEMPLATE => 'ocp-kubeconfig-XXXXXX', SUFFIX => '.yaml', TMPDIR => 1);
    Rex::Rancher::Server::fetch_kubeconfig(
        distribution => $distribution,
        server       => "" . connection->server,
        filter       => \&_kubeconfig_policy,
        file         => $fh->filename,
    );
    return $fh;
}

# OCP's policy for the kubeconfigs it uses: the CA is dropped for
# insecure-skip-tls-verify on every server entry. The same policy
# OCP::Rex::fetch_kubeconfig_ssh applies to the kubeconfig OCP keeps.
sub _kubeconfig_policy {
    my ($content) = @_;
    $content =~ s/^\s*certificate-authority-data:.*\n//mg;
    $content =~ s/(server: https:\/\/[^\n]+)/$1\n    insecure-skip-tls-verify: true/g;
    return $content;
}

# The Gateway API CRDs alone, for a cluster whose Cilium is at its pin but
# whose bundle is not: the gateway_api pin moved, the CRDs came from the
# experimental channel, or they are gone. OCP::Drift names this task as the
# remedy (k164); the name is `ocp update`'s update_<component> fallback, so
# `ocp update --component gateway_api` reaches it as well.
#
# Rex::Rancher::Cilium::ensure_gateway_api_crds applies the standard bundle as
# install_cilium does (skipped when version and channel already match, dying on
# failure) and, when it applied it, restarts a running cilium-operator: unlike
# upgrade_cilium no new operator image follows, and controller-runtime caches
# CRD schemas at startup. Cilium itself is not touched.
desc "Apply the pinned Gateway API CRDs (standard channel) and restart cilium-operator";
task "update_gateway_api", sub {
    my $params = task_params(shift);
    my $version = $params->{version} // $ENV{OCP_GATEWAY_API_VERSION}
        or die "OCP_GATEWAY_API_VERSION (or task_params version=...) is required\n";
    my $distribution = $params->{distribution} || 'rke2';

    my $local = _local_kubeconfig($distribution);

    my $applied = Rex::Rancher::Cilium::ensure_gateway_api_crds(
        kubeconfig => "$local",
        version    => $version,
        channel    => _gateway_api_channel(),
    );

    say $applied
        ? "Gateway API CRDs at $version (standard channel)"
        : "Gateway API CRDs already at $version (standard channel), nothing applied";
};

desc "Install Cilium CNI";
task "install_cilium", sub {
    my $params = task_params(shift);
    my $distribution = $params->{distribution} || 'rke2';

    # Every pin first: nothing touches the node without all three.
    my $version = $params->{version} // $ENV{OCP_CILIUM_VERSION}
        or die "OCP_CILIUM_VERSION (or task_params version=...) is required\n";
    my $cli_version = $params->{cli_version} // $ENV{OCP_CILIUM_CLI_VERSION}
        or die "OCP_CILIUM_CLI_VERSION (or task_params cli_version=...) is required\n";
    my $gateway_api_version = $params->{gateway_api_version} // $ENV{OCP_GATEWAY_API_VERSION}
        or die "OCP_GATEWAY_API_VERSION (or task_params gateway_api_version=...) is required\n";

    say "Installing Cilium CNI...";

    my $local = _local_kubeconfig($distribution);

    # pod_cidr is the pool of a fresh Cilium only: one that already runs keeps
    # its pool and API address whatever pod_cidr says (k182) -- moving them
    # under running pods is a migration, not an install.
    Rex::Rancher::Cilium::install_cilium(_cilium_opts(
        distribution        => $distribution,
        version             => $version,
        cli_version         => $cli_version,
        gateway_api_version => $gateway_api_version,
        kubeconfig          => "$local",
        cluster_cidr        => $params->{pod_cidr} || _default_pod_cidr(),
        k8s_service_host    => $params->{k8s_service_host},
        wait_duration       => 600,
    ));

    say "Cilium installed successfully";
};

#
# Update Tasks
#

desc "Upgrade Cilium to newer version";
task "upgrade_cilium", sub {
    my $params = task_params(shift);
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';
    # Read before anything touches the node: an upgrade that would stop
    # halfway for want of a pin must not start.
    my $gateway_api_version = $params->{gateway_api_version} // $ENV{OCP_GATEWAY_API_VERSION}
        or die "OCP_GATEWAY_API_VERSION (or task_params gateway_api_version=...) is required\n";
    my $cli_version = $params->{cli_version} // $ENV{OCP_CILIUM_CLI_VERSION}
        or die "OCP_CILIUM_CLI_VERSION (or task_params cli_version=...) is required\n";

    say "Upgrading Cilium to $version...";

    my $local = _local_kubeconfig($distribution);

    # The CLI, the Gateway API CRDs (they travel with Cilium, k160: the new
    # Cilium must find its bundle in place when it starts, or it runs without a
    # Gateway controller) and the Helm upgrade, in that order. No cluster_cidr:
    # the pool stays what the cluster runs (k182), as do the API address on k3s
    # and the operator's replicas; this task never acts on network.pod_cidr.
    Rex::Rancher::Cilium::upgrade_cilium(_cilium_opts(
        distribution        => $distribution,
        version             => $version,
        cli_version         => $cli_version,
        gateway_api_version => $gateway_api_version,
        kubeconfig          => "$local",
        k8s_service_host    => $params->{k8s_service_host},
        wait_duration       => 300,
    ));

    say "Cilium upgraded successfully to $version";
};

desc "Upgrade cert-manager to newer version";
task "upgrade_cert_manager", sub {
    my $params = task_params(shift);
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';

    say "Upgrading cert-manager to $version...";

    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';

    # cert-manager can be upgraded by applying new manifests
    my $url = "https://github.com/cert-manager/cert-manager/releases/download/$version/cert-manager.yaml";

    say "Applying cert-manager $version manifests...";
    run "$kubectl --kubeconfig=$kubeconfig apply -f $url";

    say "Waiting for cert-manager rollout...";
    run "$kubectl --kubeconfig=$kubeconfig wait --for=condition=Available " .
        "--timeout=300s deployment/cert-manager -n cert-manager";

    say "cert-manager upgraded successfully to $version";
};

1;
