# OCP Rexfile - Server Automation Tasks
use Rex -feature => ['1.4'];
use Rex::Commands::Run;
use Rex::Commands::Fs;
use Rex::Commands::File;
use Rex::Commands::Service;
use Rex::Commands::Pkg;

# Authentication - use Net::OpenSSH (real ssh command, not libssh2)
# Net::SSH2 (libssh2) ignores OpenSSH config options and has no way to
# disable host key checking, causing "Couldn't authenticate" on unknown hosts.
set connection => 'OpenSSH';
parallelism 1;

# SSH options - disable strict host key checking for new servers
# NOTE: Must use Rex::Config->set_openssh_opt() directly!
# "set openssh_opt => {...}" goes through generic set() which stores
# in $set_param, but get_openssh_opt() reads from a separate %openssh_opt
# variable. There is no SET_HANDLER registered to bridge them. Rex bug.
Rex::Config->set_openssh_opt(
    StrictHostKeyChecking => 'no',
    UserKnownHostsFile    => '/dev/null',
);

# SSH config from environment
if ($ENV{REX_PRIVATE_KEY}) {
    private_key $ENV{REX_PRIVATE_KEY};
    public_key $ENV{REX_PUBLIC_KEY} if $ENV{REX_PUBLIC_KEY};
    key_auth;
}

# Helper: Check OS compatibility
sub check_os {
    my $os = operating_system();
    my $version = operating_system_version();

    say "Detected OS: $os $version";

    unless ($os eq 'Debian' || $os eq 'Ubuntu') {
        say "WARNING: This OS ($os) is not officially tested.";
        say "OCP is designed for Debian/Ubuntu. Proceed with caution.";
    }
}

#
# Common Tasks
#

desc "Prepare node for Kubernetes";
task "prepare_node", sub {
    check_os();

    # Ensure required packages are installed
    pkg ["curl", "ca-certificates"], ensure => "present";

    # Disable swap
    run "swapoff -a", auto_die => FALSE;
    delete_lines_matching "/etc/fstab", matching => qr/swap/;

    # Load kernel modules
    run "modprobe br_netfilter", auto_die => FALSE;
    run "modprobe overlay", auto_die => FALSE;

    file "/etc/modules-load.d/kubernetes.conf",
        content => "br_netfilter\noverlay\n";

    # Sysctl settings
    file "/etc/sysctl.d/99-kubernetes.conf",
        content => "net.bridge.bridge-nf-call-iptables = 1\nnet.bridge.bridge-nf-call-ip6tables = 1\nnet.ipv4.ip_forward = 1\n";

    run "sysctl --system > /dev/null 2>&1";
};

desc "Detect GPU and install drivers";
task "detect_gpu", sub {
    # Ensure lspci is available
    pkg ["pciutils"], ensure => "present" unless is_installed("pciutils");

    # Use lspci -nn for reliable detection via PCI class codes + vendor IDs
    # Class [0300] = VGA controller, [0302] = 3D controller
    # Vendor [10de] = NVIDIA, [1002] = AMD/ATI
    my $pci_display = run "lspci -nn 2>&1 | grep -E '\\[03(00|02)\\]'", auto_die => FALSE;
    say "=== Display Controllers ===";
    say $pci_display || "(none found)";
    say "=== End Display Controllers ===";

    # Match only actual display controllers (VGA/3D) by vendor ID
    my $nvidia_found = ($pci_display && $pci_display =~ /\[10de:[0-9a-f]{4}\]/i);
    my $amd_found    = ($pci_display && $pci_display =~ /\[1002:[0-9a-f]{4}\]/i);

    # Check for virtual GPU passthrough (skip these — no host driver needed)
    my $is_virtual = 0;
    if ($pci_display && $pci_display =~ /\[(1af4|1b36|15ad|80ee):[0-9a-f]{4}\]/i) {
        # 1af4=virtio, 1b36=QEMU, 15ad=VMware, 80ee=VirtualBox
        $is_virtual = 1;
    }

    say "GPU Detection:";
    say "  NVIDIA display controller: " . ($nvidia_found ? "YES" : "no");
    say "  AMD display controller: " . ($amd_found ? "YES" : "no");
    say "  Virtual GPU: " . ($is_virtual ? "YES (skipping)" : "no");

    if ($is_virtual) {
        say "Virtual GPU detected — host driver installation skipped";
        return;
    }

    if ($nvidia_found) {
        say "NVIDIA GPU detected, installing drivers...";
        do_task "install_nvidia";
    } elsif ($amd_found) {
        say "AMD GPU detected, but AMD driver support not yet implemented — skipping";
    } else {
        say "No discrete GPU detected";
    }
};

desc "Install NVIDIA GPU drivers and container toolkit";
task "install_nvidia", sub {
    say "Installing NVIDIA GPU drivers and container toolkit...";

    my $os = operating_system();
    my $running_kernel = run "uname -r";
    chomp $running_kernel;
    say "  OS: $os, Kernel: $running_kernel";

    # 1. Install kernel headers + driver packages
    my @driver_packages;
    if ($os eq 'Debian') {
        @driver_packages = (
            "linux-headers-$running_kernel",  # DKMS builds for running kernel
            "linux-headers-amd64",            # Meta for latest kernel
            "nvidia-driver",                  # Driver meta-package (pulls dkms)
            "nvidia-smi",                     # nvidia-smi tool
            "libcuda1",                       # CUDA driver library (needed by container runtime!)
        );
    } elsif ($os eq 'Ubuntu') {
        @driver_packages = (
            "linux-headers-$running_kernel",
            "linux-headers-generic",
            "nvidia-driver-535",              # Includes nvidia-smi + libcuda on Ubuntu
        );
    } else {
        die "Unsupported OS for NVIDIA: $os\n";
    }

    say "  Installing driver packages...";
    update_package_db;
    pkg \@driver_packages, ensure => "present";

    # 2. Add NVIDIA container toolkit repo and install
    say "  Adding NVIDIA container toolkit repository...";
    pkg ["curl", "gnupg"], ensure => "present";

    # Download and dearmor GPG key (modern signed-by approach, not deprecated apt-key)
    run "curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg 2>/dev/null",
        auto_die => FALSE;

    # Write sources.list directly (not curl|sed pipeline)
    file "/etc/apt/sources.list.d/nvidia-container-toolkit.list",
        content => "deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://nvidia.github.io/libnvidia-container/stable/deb/\$(ARCH) /\n";

    update_package_db;

    say "  Installing nvidia-container-toolkit...";
    pkg ["nvidia-container-toolkit"], ensure => "present";

    # 3. Load nvidia kernel module
    run "modprobe nvidia", auto_die => FALSE;

    # 4. Verify everything
    _verify_nvidia();

    say "NVIDIA GPU installation complete";
};

sub _verify_nvidia {
    say "  Verifying NVIDIA installation...";
    my $ok = 1;

    # Check kernel module loaded
    my $lsmod = run "lsmod | grep '^nvidia '", auto_die => FALSE;
    if ($? != 0 || !$lsmod) {
        say "  [WARN] nvidia kernel module not loaded (reboot may be needed)";
        my $dkms = run "dkms status 2>&1 | grep nvidia", auto_die => FALSE;
        say "         DKMS: $dkms" if $dkms;
        $ok = 0;
    } else {
        say "  [ok] nvidia kernel module loaded";
    }

    # Check nvidia-smi
    my $smi = run "nvidia-smi -L 2>&1", auto_die => FALSE;
    chomp $smi if defined $smi;
    if (defined $smi && $smi =~ /GPU \d+:/) {
        say "  [ok] $smi";
    } else {
        say "  [WARN] nvidia-smi not working: " . ($smi // 'no output');
        $ok = 0;
    }

    # Check libcuda
    my $libcuda = run "ldconfig -p | grep 'libcuda.so '", auto_die => FALSE;
    if ($? == 0 && $libcuda) {
        say "  [ok] libcuda available";
    } else {
        say "  [WARN] libcuda.so not found";
        $ok = 0;
    }

    # Check container toolkit
    if (can_run("nvidia-ctk")) {
        say "  [ok] nvidia-container-toolkit installed";
    } else {
        say "  [WARN] nvidia-container-toolkit not found";
        $ok = 0;
    }

    unless ($ok) {
        say "  [WARN] GPU verification incomplete - some features may not work until reboot";
    }
}

