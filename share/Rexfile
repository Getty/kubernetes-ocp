# The install itself lives in Rex::Rancher and Rex::GPU, which exist for OCP
# (k155): node preparation, the RKE2/K3s server and agent installs, Cilium with
# the Gateway API CRDs, and the NVIDIA driver and container toolkit. This file
# keeps what is OCP's own -- the parameter hand-over, the pod network, GPU
# detection from sysfs, the legacy-file cleanups, the API wait -- and every
# piece the libraries cannot yet express, each marked with the card on the
# library's board that would move it there.
#
# Loaded without imports: every call below names its library, so no library
# function can shadow a task of the same name (install_cilium, prepare_node).
use Rex::Rancher::Node ();
use Rex::Rancher::Server ();
use Rex::Rancher::Agent ();
use Rex::Rancher::Cilium ();
use Rex::GPU::NVIDIA ();

# Authentication — Rex::Interface::Connection::LibSSH (Net::LibSSH).
# Pure libssh in-process: no ssh client subprocess, no SFTP subsystem,
# no ControlMaster sockets, no parsing of ~/.ssh/config.
set connection => 'LibSSH';
parallelism 1;

# Host keys (k168). Rex::LibSSH 0.004 verifies the server's host key and
# refuses one it cannot find. OCP::Rex hands over OCP's own known_hosts file as
# OCP_KNOWN_HOSTS, after making sure the host is in it (OCP::SSH records the key
# on first contact) -- so the check stays on, against that file, and a changed
# key fails the connection. Run by hand without the variable, libssh checks
# ~/.ssh/known_hosts, strict as well.
if ($ENV{OCP_KNOWN_HOSTS}) {
    Rex::Config->set_openssh_opt(StrictHostKeyChecking => 'yes',
        UserKnownHostsFile => $ENV{OCP_KNOWN_HOSTS});
}

# SSH key from environment
if ($ENV{REX_PRIVATE_KEY}) {
    private_key $ENV{REX_PRIVATE_KEY};
    public_key $ENV{REX_PUBLIC_KEY} if $ENV{REX_PUBLIC_KEY};
    key_auth;
}

# Helper: Task parameters
#
# OCP::Rex hands parameters over as one JSON blob in REX_TASK_PARAMS rather
# than as CLI arguments. Reasons, in order of weight: secrets (the RKE2/K3s
# join token) stay out of the process command line where `ps` exposes them
# to every local user; nested structures survive; and the payload is
# generated by an encoder instead of assembled by hand.
#
# Rex's own `--key=value` form still wins when present, so every task stays
# runnable straight from the shell for debugging. Note the leading dashes —
# bare `key=value` is silently ignored by Rex, it never reaches the task.
sub task_params {
    my ($cli) = @_;

    return $cli if ref $cli eq 'HASH' && %$cli;
    return {} unless defined $ENV{REX_TASK_PARAMS} && length $ENV{REX_TASK_PARAMS};

    my $params = eval { JSON::MaybeXS->new(utf8 => 1)->decode($ENV{REX_TASK_PARAMS}) };
    die "REX_TASK_PARAMS is not valid JSON: $@" if $@;

    return ref $params eq 'HASH' ? $params : {};
}

# Helper: Check OS compatibility
sub check_os {
    my $os = operating_system();
    my $version = operating_system_version();

    say "Detected OS: $os $version";

    unless ($os eq 'Debian' || $os eq 'Ubuntu') {
        say "WARNING: This OS ($os) is not officially tested.";
        say "OCP is designed for Debian/Ubuntu. Proceed with caution.";
    }
}

# Where each distribution keeps its kubectl and its admin kubeconfig on the node.
sub _kube {
    my ($distribution) = @_;
    return $distribution eq 'k3s'
        ? ('kubectl', '/etc/rancher/k3s/k3s.yaml')
        : ('/var/lib/rancher/rke2/bin/kubectl', '/etc/rancher/rke2/rke2.yaml');
}

#
# Common Tasks
#

desc "Prepare node for Kubernetes";
task "prepare_node", sub {
    my $params = task_params(shift);
    my $hostname = $params->{hostname} || '';
    my $domain   = $params->{domain}   || '';
    my $timezone = $params->{timezone} || 'UTC';
    my $locale   = $params->{locale}   || 'en_US.UTF-8';
    my $ntp      = $params->{ntp}      // 1;

    check_os();

    # Rex::Rancher (0.003, rex-rancher k42): apt refresh (with the apt timers
    # stopped that hold its lock on a fresh boot), curl + ca-certificates,
    # hostname, and without a domain `127.0.1.1 hostname` in /etc/hosts unless a
    # line names the host already; the timezone, the locale enabled in
    # /etc/locale.gen and generated before it is set; NTP, swap off,
    # br_netfilter/overlay, the Kubernetes sysctls.
    #
    # NTP is the library's with OCP's semantics (etcd and kube-apiserver need a
    # synchronised clock, a node without one still works): a clock timedatectl
    # already reports as NTP-synchronised is left alone, otherwise chrony; a
    # failed chrony install falls back to systemd-timesyncd, and without either
    # the library warns instead of dying.
    #
    # A locale not shaped like en_US.UTF-8 or a timezone not shaped like a
    # zoneinfo name (Europe/Berlin, UTC) dies here, before the host is touched:
    # both end up in shell commands.
    Rex::Rancher::Node::prepare_node(
        ($hostname ? (hostname => $hostname) : ()),
        ($domain   ? (domain   => $domain)   : ()),
        timezone => $timezone,
        locale   => $locale,
        ntp      => $ntp,
    );

    # Every install task comes through here, for both distributions and both
    # roles, and it runs before the service is (re)started -- which is exactly
    # when an inherited containerd template still has a chance to be thrown
    # away instead of being rendered again. See the task itself for why this
    # is a content check and not an unlink.
    do_task "cleanup_legacy_containerd_template";
};

# The prepare_node parameters out of an install task's parameters.
sub _node_params {
    my ($params) = @_;
    return {
        hostname => $params->{hostname} || '',
        domain   => $params->{domain}   || '',
        timezone => $params->{timezone} || 'UTC',
        locale   => $params->{locale}   || 'en_US.UTF-8',
        ntp      => $params->{ntp}      // 1,
    };
}

# Should this node get the host-side GPU treatment at all?
#
# Two spec keys, one question. `gpu.enabled: false` switches OCP's GPU handling
# off for the whole cluster, and `gpu.driver: operator` hands the driver *and*
# the container toolkit to the GPU Operator's DaemonSets — in both cases Rex
# has to keep its hands off the host.
#
# Missing parameters mean yes. robocop joins workers through the same tasks
# without passing either key, and a worker that quietly came up without its
# driver would be a worse failure than an ignored switch.
sub _maybe_detect_gpu {
    my ($params) = @_;

    unless ($params->{gpu} // 1) {
        say "GPU handling disabled (gpu.enabled: false) — skipping detection";
        return;
    }

    my $driver = $params->{gpu_driver} || 'host';
    unless ($driver eq 'host') {
        say "GPU driver mode '$driver' — the GPU Operator installs driver and toolkit, skipping host install";
        return;
    }

    do_task "detect_gpu";
}

desc "Detect NVIDIA GPU hardware and install drivers";
task "detect_gpu", sub {
    my @display = _pci_display_devices();

    say "=== Display Controllers ===";
    if (@display) {
        say "  $_->{slot}  $_->{vendor}:$_->{device}  class $_->{class}" for @display;
    } else {
        say "  (none found)";
    }
    say "=== End Display Controllers ===";

    my $action = _gpu_action(@display);

    if ($action eq 'nvidia') {
        my @nvidia = grep { $_->{vendor} eq '10de' } @display;
        say "NVIDIA GPU present: " . join(', ', map { "$_->{vendor}:$_->{device}" } @nvidia);
        do_task "install_nvidia";
    }
    elsif ($action eq 'virtual') {
        say "Virtual GPU only (virtio/QEMU/VMware/VBox) — no host driver needed";
    }
    elsif ($action eq 'amd') {
        say "AMD GPU detected — driver support not yet implemented";
    }
    else {
        say "No NVIDIA GPU found";
    }
};

# What should the bootstrap do about the display hardware it found?
# 'nvidia' (install the driver), 'virtual', 'amd' or 'none'.
#
# Before the cluster exists there is exactly one question worth asking: does
# this host need an NVIDIA driver? That is "NVIDIA hardware present" plus "no
# working driver yet", and install_nvidia answers the second half. Whether the
# card is worth scheduling on is decided later and elsewhere, by the device
# plugin publishing nvidia.com/gpu — not here by guessing at a model name.
sub _gpu_action {
    my (@display) = @_;

    # NVIDIA hardware settles it, and it is checked first on purpose: a VM with
    # a passed-through GPU has a virtio display adapter *and* the card, and
    # there the card wins. The virtual list only answers "nothing here needs a
    # host driver", which is only true when nothing else is here.
    return 'nvidia' if grep { $_->{vendor} eq '10de' } @display;

    # A short list of "definitely not" stays true as hardware moves on, which
    # is why this blacklist survives while the model whitelist did not.
    return 'virtual' if grep { $_->{vendor} =~ /^(?:1af4|1b36|15ad|80ee)$/ } @display;

    return 'amd' if grep { $_->{vendor} eq '1002' } @display;

    return 'none';
}

# Display and 3D controllers as the kernel reports them:
# { slot, vendor, device, class }, all lowercase hex without the 0x prefix.
#
# sysfs, not `lspci`. lspci prints the *name* it finds for a PCI ID in the
# host's pci.ids database, and that database is always older than the newest
# card — a DGX Spark prints `Device [10de:2e12]` for its GB10, which no list of
# marketing names can ever match. Vendor and class come from the hardware
# itself, need neither a database nor pciutils, and are precisely the pair NFD
# labels the node with in-cluster (feature.node.kubernetes.io/pci-0300_10de).
sub _pci_display_devices {
    my $raw = run
          q{for d in /sys/bus/pci/devices/*/; do }
        . q{test -r "$d/class" || continue; }
        . q{printf '%s|%s|%s|%s\n' "${d%/}" }
        . q{"$(cat "$d/vendor" 2>/dev/null)" }
        . q{"$(cat "$d/device" 2>/dev/null)" }
        . q{"$(cat "$d/class" 2>/dev/null)"; }
        . q{done},
        auto_die => FALSE;

    return () unless defined $raw;

    my @devices;
    for my $line (split /\n/, $raw) {
        my ($path, $vendor, $device, $class) = split /\|/, $line, 4;
        next unless defined $class;

        # 0x0300xx = VGA controller, 0x0302xx = 3D controller. The last byte is
        # the programming interface and is not part of the class we match on.
        my ($class_id)  = $class  =~ /^0x(0300|0302)[0-9a-f]{2}$/i or next;
        my ($vendor_id) = $vendor =~ /^0x([0-9a-f]{4})$/i          or next;
        my ($device_id) = $device =~ /^0x([0-9a-f]{4})$/i;

        my $slot = $path;
        $slot =~ s{.*/}{};

        push @devices, {
            slot   => $slot,
            vendor => lc $vendor_id,
            device => lc($device_id // '????'),
            class  => lc $class_id,
        };
    }

    return @devices;
}

# The NVIDIA cards among the display devices, in the shape
# Rex::GPU::NVIDIA::install_driver takes from a caller that finds its GPUs
# without lspci (rex-gpu k42): device_id as exactly four hex digits, and a
# name for its messages -- sysfs has none, so the PCI ID stands in. A device
# ID sysfs would not give is left out rather than guessed: the library then
# treats the card as one it does not know.
sub _nvidia_gpus {
    my (@display) = @_;
    return map {
        +{
            name => "NVIDIA GPU [10de:$_->{device}]",
            ($_->{device} =~ /^[0-9a-f]{4}$/ ? (device_id => $_->{device}) : ()),
        }
    } grep { $_->{vendor} eq '10de' } @display;
}

desc "Install NVIDIA GPU drivers and container toolkit";
task "install_nvidia", sub {
    say "Installing NVIDIA GPU drivers and container toolkit...";

    my $os = operating_system();

    # 1. The driver.
    #
    # Rex::GPU::NVIDIA::install_driver leaves a working driver alone (nvidia-smi
    # lists a GPU and libcuda is in the linker cache -- vendor appliances such
    # as a DGX ship one matched to their kernel and silicon, and apt pulling
    # another branch over it breaks the machine), picks the driver by GPU
    # generation from the device IDs, installs only the running kernel's
    # headers -- never linux-headers-generic, which on a vendor kernel such as
    # a DGX Spark's (6.17.0-1029-nvidia) is a different kernel --, loads the
    # module and verifies the result.
    #
    # Ubuntu (k191, rex-gpu k69): Setup::UbuntuDrivers has `ubuntu-drivers list
    # --gpgpu` name the package, installs it with apt-get and verifies it with
    # dpkg. No package name is guessed: ubuntu-drivers missing, failing or
    # naming nothing for the card dies before any driver package goes in.
    # Deliberately different from OCP's own path before it (ADR 0015):
    # ubuntu-drivers now picks only the branch, within the kernel-module flavour
    # Rex::GPU derives from the device IDs -- open for Blackwell (GB10 among
    # them), proprietary where its table asks for nothing (Turing to Hopper),
    # and for Maxwell, Pascal and Volta the 580-server branch without asking
    # ubuntu-drivers at all. In return a package that cannot drive the card
    # (proprietary on a Blackwell) is refused. The packages are the -server
    # ones; `ubuntu-drivers install` is never run.
    Rex::GPU::NVIDIA::install_driver(
        gpus => [ _nvidia_gpus(_pci_display_devices()) ],
        ($os eq 'Ubuntu' ? (setup => 'Rex::GPU::NVIDIA::Setup::UbuntuDrivers') : ()),
    );

    # 2. The container toolkit.
    #
    # A vendor image already has it — on a DGX Spark, /usr/bin/nvidia-container-runtime
    # and nvidia-ctk are there before OCP is. Adding NVIDIA's apt source to such
    # a host changes where its packages come from for everything that follows,
    # for no gain, so the presence of a working runtime ends this step. OCP asks
    # for the binaries the CRI execs; the library's own skip additionally wants
    # the dpkg package, which a runtime installed any other way does not have.
    if (_nvidia_toolkit_present()) {
        say "  Container toolkit already present — leaving the host's apt sources alone";
    } else {
        Rex::GPU::NVIDIA::install_container_toolkit();
    }

    # 3. Verify everything; warns, never dies (a reboot may still be due).
    Rex::GPU::NVIDIA::verify_nvidia();

    say "NVIDIA GPU installation complete";
};

# Is a usable NVIDIA container runtime already on this host?
#
# Ask for the binaries the CRI actually execs, not for a package name: vendor
# appliances install outside the distribution's package namespace. A DGX image
# installs both, and k3s and RKE2 find nvidia-container-runtime on PATH by
# themselves.
sub _nvidia_toolkit_present {
    return 0 unless can_run("nvidia-container-runtime");
    return 0 unless can_run("nvidia-ctk");
    say "  Existing NVIDIA container toolkit detected";
    return 1;
}

