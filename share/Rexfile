desc "Prepare node for Kubernetes";
task "prepare_node", sub {
    my $params = task_params(shift);
    my $hostname = $params->{hostname} || '';
    my $domain   = $params->{domain}   || '';
    my $timezone = $params->{timezone} || 'UTC';
    my $locale   = $params->{locale}   || 'en_US.UTF-8';
    my $ntp      = $params->{ntp}      // 1;

    check_os();

    # Rex::Rancher: apt refresh (with the apt timers stopped that hold its lock
    # on a fresh boot), curl + ca-certificates, hostname, timezone, locale,
    # swap off, br_netfilter/overlay, the Kubernetes sysctls. NTP is OCP's
    # own below, so the library is told to leave it alone.
    Rex::Rancher::Node::prepare_node(
        ($hostname ? (hostname => $hostname) : ()),
        ($domain   ? (domain   => $domain)   : ()),
        timezone => $timezone,
        locale   => $locale,
        ntp      => 0,
    );

    # Rex::Rancher writes the /etc/hosts entry only with a domain; OCP knows
    # none, robocop's joins neither, and the node still resolves its own name
    # (rex-rancher k42).
    if ($hostname && !$domain) {
        host_entry $hostname,
            ensure  => "present",
            ip      => "127.0.1.1",
            aliases => [$hostname];
    }

    # The library sets LANG but does not generate the locale (rex-rancher k42).
    run "locale-gen $locale >/dev/null 2>&1", auto_die => FALSE;

    _ensure_ntp() if $ntp;

    # Every install task comes through here, for both distributions and both
    # roles, and it runs before the service is (re)started -- which is exactly
    # when an inherited containerd template still has a chance to be thrown
    # away instead of being rendered again. See the task itself for why this
    # is a content check and not an unlink.
    do_task "cleanup_legacy_containerd_template";
};

# etcd/kube-apiserver need clock sync. Prefer what's already running:
#   1. If timedatectl says "System clock synchronized: yes" → done
#   2. Otherwise try chrony (best-effort, don't die — systemd-timesyncd
#      may be active even if not yet "synchronized" from timedatectl's POV)
# Rex::Rancher installs chrony unconditionally and dies when that fails, so
# this stays here until rex-rancher k42.
sub _ensure_ntp {
    my $tdc = run "timedatectl show --property=NTPSynchronized --value 2>/dev/null", auto_die => FALSE;
    chomp $tdc if defined $tdc;
    if (defined $tdc && $tdc eq 'yes') {
        say "NTP already synchronized (skipping chrony install)";
        return;
    }

    say "Ensuring NTP (chrony)...";
    eval { pkg ["chrony"], ensure => "present"; 1 };
    if (my $err = $@) {
        say "  chrony install failed: $err";
        say "  Checking systemd-timesyncd as fallback...";
        my $ts_active = run "systemctl is-active systemd-timesyncd 2>/dev/null", auto_die => FALSE;
        chomp $ts_active if defined $ts_active;
        if (defined $ts_active && $ts_active eq 'active') {
            say "  [ok] systemd-timesyncd is active — using that";
        } else {
            run "systemctl enable --now systemd-timesyncd 2>&1", auto_die => FALSE;
            say "  (best-effort: started systemd-timesyncd)";
        }
    } else {
        run "systemctl enable --now chronyd 2>/dev/null || systemctl enable --now chrony 2>/dev/null", auto_die => FALSE;
    }
}

# The prepare_node parameters out of an install task's parameters.
sub _node_params {
    my ($params) = @_;
    return {
        hostname => $params->{hostname} || '',
        domain   => $params->{domain}   || '',
        timezone => $params->{timezone} || 'UTC',
        locale   => $params->{locale}   || 'en_US.UTF-8',
        ntp      => $params->{ntp}      // 1,
    };
}

# Should this node get the host-side GPU treatment at all?
#
# Two spec keys, one question. `gpu.enabled: false` switches OCP's GPU handling
# off for the whole cluster, and `gpu.driver: operator` hands the driver *and*
# the container toolkit to the GPU Operator's DaemonSets — in both cases Rex
# has to keep its hands off the host.
#
# Missing parameters mean yes. robocop joins workers through the same tasks
# without passing either key, and a worker that quietly came up without its
# driver would be a worse failure than an ignored switch.
sub _maybe_detect_gpu {
    my ($params) = @_;

    unless ($params->{gpu} // 1) {
        say "GPU handling disabled (gpu.enabled: false) — skipping detection";
        return;
    }

    my $driver = $params->{gpu_driver} || 'host';
    unless ($driver eq 'host') {
        say "GPU driver mode '$driver' — the GPU Operator installs driver and toolkit, skipping host install";
        return;
    }

    do_task "detect_gpu";
}

desc "Detect NVIDIA GPU hardware and install drivers";
task "detect_gpu", sub {
    my @display = _pci_display_devices();

    say "=== Display Controllers ===";
    if (@display) {
        say "  $_->{slot}  $_->{vendor}:$_->{device}  class $_->{class}" for @display;
    } else {
        say "  (none found)";
    }
    say "=== End Display Controllers ===";

    my $action = _gpu_action(@display);

    if ($action eq 'nvidia') {
        my @nvidia = grep { $_->{vendor} eq '10de' } @display;
        say "NVIDIA GPU present: " . join(', ', map { "$_->{vendor}:$_->{device}" } @nvidia);
        do_task "install_nvidia";
    }
    elsif ($action eq 'virtual') {
        say "Virtual GPU only (virtio/QEMU/VMware/VBox) — no host driver needed";
    }
    elsif ($action eq 'amd') {
        say "AMD GPU detected — driver support not yet implemented";
    }
    else {
        say "No NVIDIA GPU found";
    }
};

# What should the bootstrap do about the display hardware it found?
# 'nvidia' (install the driver), 'virtual', 'amd' or 'none'.
#
# Before the cluster exists there is exactly one question worth asking: does
# this host need an NVIDIA driver? That is "NVIDIA hardware present" plus "no
# working driver yet", and install_nvidia answers the second half. Whether the
# card is worth scheduling on is decided later and elsewhere, by the device
# plugin publishing nvidia.com/gpu — not here by guessing at a model name.
sub _gpu_action {
    my (@display) = @_;

    # NVIDIA hardware settles it, and it is checked first on purpose: a VM with
    # a passed-through GPU has a virtio display adapter *and* the card, and
    # there the card wins. The virtual list only answers "nothing here needs a
    # host driver", which is only true when nothing else is here.
    return 'nvidia' if grep { $_->{vendor} eq '10de' } @display;

    # A short list of "definitely not" stays true as hardware moves on, which
    # is why this blacklist survives while the model whitelist did not.
    return 'virtual' if grep { $_->{vendor} =~ /^(?:1af4|1b36|15ad|80ee)$/ } @display;

    return 'amd' if grep { $_->{vendor} eq '1002' } @display;

    return 'none';
}

# Display and 3D controllers as the kernel reports them:
# { slot, vendor, device, class }, all lowercase hex without the 0x prefix.
#
# sysfs, not `lspci`. lspci prints the *name* it finds for a PCI ID in the
# host's pci.ids database, and that database is always older than the newest
# card — a DGX Spark prints `Device [10de:2e12]` for its GB10, which no list of
# marketing names can ever match. Vendor and class come from the hardware
# itself, need neither a database nor pciutils, and are precisely the pair NFD
# labels the node with in-cluster (feature.node.kubernetes.io/pci-0300_10de).
sub _pci_display_devices {
    my $raw = run
          q{for d in /sys/bus/pci/devices/*/; do }
        . q{test -r "$d/class" || continue; }
        . q{printf '%s|%s|%s|%s\n' "${d%/}" }
        . q{"$(cat "$d/vendor" 2>/dev/null)" }
        . q{"$(cat "$d/device" 2>/dev/null)" }
        . q{"$(cat "$d/class" 2>/dev/null)"; }
        . q{done},
        auto_die => FALSE;

    return () unless defined $raw;

    my @devices;
    for my $line (split /\n/, $raw) {
        my ($path, $vendor, $device, $class) = split /\|/, $line, 4;
        next unless defined $class;

        # 0x0300xx = VGA controller, 0x0302xx = 3D controller. The last byte is
        # the programming interface and is not part of the class we match on.
        my ($class_id)  = $class  =~ /^0x(0300|0302)[0-9a-f]{2}$/i or next;
        my ($vendor_id) = $vendor =~ /^0x([0-9a-f]{4})$/i          or next;
        my ($device_id) = $device =~ /^0x([0-9a-f]{4})$/i;

        my $slot = $path;
        $slot =~ s{.*/}{};

        push @devices, {
            slot   => $slot,
            vendor => lc $vendor_id,
            device => lc($device_id // '????'),
            class  => lc $class_id,
        };
    }

    return @devices;
}

# The NVIDIA cards among the display devices, in the shape
# Rex::GPU::NVIDIA::install_driver takes from a caller that finds its GPUs
# without lspci (rex-gpu k42): device_id as exactly four hex digits, and a
# name for its messages -- sysfs has none, so the PCI ID stands in. A device
# ID sysfs would not give is left out rather than guessed: the library then
# treats the card as one it does not know.
sub _nvidia_gpus {
    my (@display) = @_;
    return map {
        +{
            name => "NVIDIA GPU [10de:$_->{device}]",
            ($_->{device} =~ /^[0-9a-f]{4}$/ ? (device_id => $_->{device}) : ()),
        }
    } grep { $_->{vendor} eq '10de' } @display;
}

desc "Install NVIDIA GPU drivers and container toolkit";
task "install_nvidia", sub {
    say "Installing NVIDIA GPU drivers and container toolkit...";

    my $os = operating_system();

    # 1. The driver.
    #
    # Rex::GPU::NVIDIA::install_driver leaves a working driver alone (nvidia-smi
    # lists a GPU and libcuda is in the linker cache -- vendor appliances such
    # as a DGX ship one matched to their kernel and silicon, and apt pulling
    # another branch over it breaks the machine), picks the driver by GPU
    # generation from the device IDs, installs only the running kernel's
    # headers, and verifies the result.
    #
    # Ubuntu stays OCP's own until rex-gpu k69: the library installs
    # linux-headers-generic there -- headers for a different kernel on a
    # vendor kernel like a DGX Spark's -- and picks the driver package by
    # apt-cache search instead of letting ubuntu-drivers decide.
    if ($os eq 'Ubuntu') {
        if (_nvidia_driver_present()) {
            say "  Host driver already present and working — skipping driver install";
            say "  (OCP only adds the container toolkit on top of it)";
        } else {
            my $running_kernel = run "uname -r";
            chomp $running_kernel;
            _install_nvidia_driver_ubuntu($running_kernel);
        }
        run "modprobe nvidia", auto_die => FALSE;
    } else {
        Rex::GPU::NVIDIA::install_driver(gpus => [ _nvidia_gpus(_pci_display_devices()) ]);
    }

    # 2. The container toolkit.
    #
    # A vendor image already has it — on a DGX Spark, /usr/bin/nvidia-container-runtime
    # and nvidia-ctk are there before OCP is. Adding NVIDIA's apt source to such
    # a host changes where its packages come from for everything that follows,
    # for no gain, so the presence of a working runtime ends this step. OCP asks
    # for the binaries the CRI execs; the library's own skip additionally wants
    # the dpkg package, which a runtime installed any other way does not have.
    if (_nvidia_toolkit_present()) {
        say "  Container toolkit already present — leaving the host's apt sources alone";
    } else {
        Rex::GPU::NVIDIA::install_container_toolkit();
    }

    # 3. Verify everything; warns, never dies (a reboot may still be due).
    Rex::GPU::NVIDIA::verify_nvidia();

    say "NVIDIA GPU installation complete";
};

# Ubuntu: let `ubuntu-drivers` choose the driver package (rex-gpu k69).
#
# Three questions decide which package is correct here, and OCP can answer none
# of them from the outside:
#
#   branch   `nvidia-driver-535` used to be hardcoded. R535 reached end of life
#            in June 2026, and on Ubuntu 24.04 the name now survives only as a
#            transitional package that pulls 580 — so the pin pinned nothing,
#            on amd64 just as much as on arm64.
#   flavour  Grace Hopper and Blackwell run *only* the open kernel modules; the
#            proprietary driver is unsupported on them (NVIDIA, "NVIDIA
#            Transitions Fully Towards Open-Source GPU Kernel Modules"). Maxwell,
#            Pascal and Volta are the other way round. `-open` is part of the
#            package name, so this is a naming decision, not a flag.
#   arch     amd64 and arm64 do not carry the same names, and on arm64 the
#            packages come from the ports archive.
#
# `ubuntu-drivers` answers all three from the card's PCI modalias — the same
# evidence NFD labels the node from — and it is what Ubuntu documents as the
# recommended installation path. It structurally cannot select a package that
# does not claim this card, which is the guarantee a literal package name never
# gives. A guessed name is how a working machine becomes a broken one, so OCP
# does not guess: if the tool is missing or fails, this dies and says so.
sub _install_nvidia_driver_ubuntu {
    my ($running_kernel) = @_;

    update_package_db;

    # Headers for the *running* kernel, and only those. `linux-headers-generic`
    # used to be in this list; it tracks the generic flavour, which on a vendor
    # kernel (a DGX Spark runs 6.17.0-1029-nvidia) is a different kernel
    # altogether — DKMS would build against headers the machine does not run.
    say "  Installing kernel headers for $running_kernel...";
    pkg ["linux-headers-$running_kernel"], ensure => "present";

    pkg ["ubuntu-drivers-common"], ensure => "present";

    my $listed = run "ubuntu-drivers list 2>&1", auto_die => FALSE;
    say "  ubuntu-drivers list:";
    say "    $_" for grep { length } split /\n/, ($listed // '(no output)');

    say "  Installing the recommended driver...";
    my $out = run "ubuntu-drivers install 2>&1", auto_die => FALSE;
    my $rc  = $?;
    say "    $_" for grep { length } split /\n/, ($out // '');

    if ($rc != 0) {
        die "ubuntu-drivers could not install a driver on this host.\n"
          . "OCP does not fall back to a guessed package name — the wrong branch\n"
          . "or the wrong kernel-module flavour breaks the machine. Install the\n"
          . "driver NVIDIA documents for this GPU and this kernel by hand, then\n"
          . "re-run: OCP skips the driver install once nvidia-smi answers.\n";
    }
}

# Is a working NVIDIA driver already installed on this host? (Ubuntu path only;
# Rex::GPU asks the same question itself.)
#
# "Working" is deliberately defined by what the container stack consumes, not
# by package state: nvidia-smi enumerates GPUs, and libcuda.so is in the
# linker cache. Package state would be the wrong question — vendor appliances
# install their driver outside the distribution's package namespace, so apt
# happily reports "not installed" for a machine that is running one.
sub _nvidia_driver_present {
    my $smi = run "nvidia-smi -L 2>&1", auto_die => FALSE;
    return 0 unless defined $smi && $smi =~ /GPU \d+:/;

    my $libcuda = run "ldconfig -p | grep 'libcuda.so '", auto_die => FALSE;
    unless (defined $libcuda && length $libcuda) {
        say "  nvidia-smi answers but libcuda.so is missing — driver is incomplete";
        return 0;
    }

    my $ver = run "nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1",
        auto_die => FALSE;
    chomp $ver if defined $ver;
    say "  Existing NVIDIA driver detected" . (($ver) ? " (version $ver)" : '');

    return 1;
}

# Is a usable NVIDIA container runtime already on this host?
#
# Same reasoning as _nvidia_driver_present: ask for the binaries the CRI
# actually execs, not for a package name. A DGX image installs both, and k3s
# and RKE2 find nvidia-container-runtime on PATH by themselves.
sub _nvidia_toolkit_present {
    return 0 unless can_run("nvidia-container-runtime");
    return 0 unless can_run("nvidia-ctk");
    say "  Existing NVIDIA container toolkit detected";
    return 1;
}

