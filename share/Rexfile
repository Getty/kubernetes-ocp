desc "Untaint control plane (allow workloads)";
task "untaint_control_plane", sub {
    my $params = task_params(shift);
    my $distribution = $params->{distribution} || 'rke2';

    say "Removing control plane taints...";

    if ($distribution eq 'rke2') {
        # Wait for node to be registered
        run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 2; done", timeout => 60;

        # Get node name
        my $node = run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath='{.items[0].metadata.name}'";
        chomp $node;

        # Remove taints
        run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml taint nodes $node node-role.kubernetes.io/control-plane:NoSchedule- || true";
        run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml taint nodes $node node-role.kubernetes.io/master:NoSchedule- || true";
    } else {
        # K3s
        run "while ! kubectl get nodes 2>/dev/null; do sleep 2; done", timeout => 60;

        my $node = run "kubectl get nodes -o jsonpath='{.items[0].metadata.name}'";
        chomp $node;

        run "kubectl taint nodes $node node-role.kubernetes.io/control-plane:NoSchedule- || true";
        run "kubectl taint nodes $node node-role.kubernetes.io/master:NoSchedule- || true";
    }

    say "Control plane untainted, workloads can be scheduled";
};

#
# Helpers
#

sub _generate_token {
    my $token = run "head -c 48 /dev/urandom | base64 | tr -d '\\n+/='";
    chomp $token;
    return substr($token, 0, 48);
}

sub _generate_registries_yaml {
    my (%opts) = @_;
    my $cache_endpoint    = $opts{registry_cache}    || 'http://localhost:30500';
    my $upstream_endpoint = $opts{registry_upstream}  || 'http://localhost:30501';
    my $registry_name     = $opts{registry_name}      || 'ocp.internal';

    return <<"YAML";
mirrors:
  docker.io:
    endpoint:
      - $cache_endpoint
  registry.local:
    endpoint:
      - $upstream_endpoint
  $registry_name:
    endpoint:
      - $upstream_endpoint
YAML
}

# Let RKE2 find the NVIDIA container runtime.
#
# OCP writes no containerd configuration for the GPU any more, and nothing
# calls this for k3s. Both distributions run the same agent code: at startup it
# scans PATH for `nvidia-container-runtime` (with /usr/local/nvidia/toolkit and
# /opt/kwasm/bin prepended unconditionally, which is where the GPU Operator's
# toolkit DaemonSet installs), writes every runtime it finds into its own
# containerd config, and k3s additionally ships the matching RuntimeClass
# objects. Verified on a DGX Spark running k3s: the runtime and the `nvidia`
# RuntimeClass were both there with no help from OCP.
#
# What RKE2 does not do is give its unit a PATH — rke2-server.service carries
# no Environment= line at all — so the RKE2 docs (docs.rke2.io/add-ons/
# gpu_operators) tell you to put one in the EnvironmentFile. That is the only
# thing left for OCP to write, and it touches nothing but that one variable.
#
# It replaces a containerd config *template*: that one wrote RKE2 paths
# unconditionally, so under k3s it silently did nothing, and its content was
# `imports = [...]` plus `version = 2` with no `{{ template "base" . }}`.
# k3s/RKE2 render such a template *instead of* their generated config, so on an
# RKE2 GPU node it would have thrown away the registry mirrors, the sandbox
# image and the CNI settings along with everything else.
sub _configure_nvidia_runtime_path {
    my ($unit) = @_;
    return unless can_run("nvidia-container-runtime");

    my $env_file = "/etc/default/$unit";
    say "Making the NVIDIA container runtime visible to $unit...";

    # A fixed list, not the SSH session's PATH: this becomes the environment of
    # a service running as root. These are systemd's own default directories.
    file $env_file, content => '' unless is_file($env_file);
    append_if_no_such_line $env_file,
        line   => 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
        regexp => qr{^PATH=};

    say "  [ok] $env_file carries a PATH for the runtime lookup";
}

# The containerd config template OCP used to write, byte for byte.
#
# _configure_nvidia_containerd wrote exactly these two lines (56 bytes) to
# /var/lib/rancher/rke2/agent/etc/containerd/config.toml.tmpl. karr #23 deleted
# the code; nothing removes the file. RKE2 and k3s render config.toml from such
# a template on every service start, *instead of* the config they generate
# themselves, so a host bootstrapped before that fix keeps running containerd
# off this two-liner forever -- no registry mirrors, no sandbox image, no CNI
# settings -- and upgrading OCP does not help, because the damage is a file and
# not code. Measured on cortex (karr #45).
#
# `ocp destroy` takes /var/lib/rancher with it, so the host this matters for is
# the one that gets bootstrapped once and only ever upgraded afterwards.
sub _legacy_containerd_template {
    return qq{imports = ["/etc/containerd/conf.d/*.toml"]\nversion = 2\n};
}

# Removal is decided by content, never by path. A template sitting there that
# OCP did not write is somebody's deliberate configuration and has to survive
# untouched -- that is the whole reason this is a content comparison and not an
# `unlink`.
#
# Trailing whitespace is normalised on both sides so a stray or missing final
# newline still counts as ours. Nothing else is tolerated: an extra directive, a
# different import glob, or the `{{ template "base" . }}` line that a real
# custom template needs all mean the file belongs to someone else.
sub _is_legacy_containerd_template {
    my ($content) = @_;
    return 0 unless defined $content && length $content;

    my $known = _legacy_containerd_template();
    s/\s+\z// for $content, $known;

    return $content eq $known ? 1 : 0;
}

# Both distributions. Only the RKE2 path was ever written by OCP (the deleted
# code hardcoded it, which is why it silently did nothing under k3s), but k3s
# renders a template it finds in exactly the same way, and the content check is
# what makes looking there safe.
sub _legacy_containerd_template_paths {
    return (
        '/var/lib/rancher/rke2/agent/etc/containerd/config.toml.tmpl',
        '/var/lib/rancher/k3s/agent/etc/containerd/config.toml.tmpl',
    );
}

desc "Remove the obsolete containerd config template OCP wrote before karr #23";
task "cleanup_legacy_containerd_template", sub {
    for my $path (_legacy_containerd_template_paths()) {
        next unless is_file($path);

        my $content = eval { cat $path };
        unless (_is_legacy_containerd_template($content)) {
            say "Keeping $path: content is not the template OCP used to write";
            next;
        }

        unlink $path;
        say "Removed obsolete containerd template $path -- it was OCP's pre-#23 "
          . "two-liner and was overriding the generated containerd config; "
          . "the next service start renders that config again";
    }
};

#
# Cilium Tasks
#

# Every Cilium version flows in from OCP::Versions via the task parameter
# JSON (REX_TASK_PARAMS, set by OCP::Rex::install_server) or, for hand-runs,
# from an explicit OCP_*_VERSION environment variable. There are no
# constants in this file because every pin lives exactly once, in
# OCP::Versions (ADR 0014): duplicating the pin here is how the install
# ran against an older Cilium and OCP::Drift reported drift against the
# distribution's own manifest on the next status call.
#
# Gateway API is version-locked to Cilium: 1.20 requires the CRDs from
# v1.6.1, because it demands tlsroutes/referencegrants/backendtlspolicies
# at gateway.networking.k8s.io/v1. Older bundles serve those as v1alpha2
# or v1beta1, and the operator then refuses to start its Gateway
# controller at all — Gateway and GatewayClass sit at Accepted=Unknown.
# Bumping the pin means bumping both together.

desc "Install Cilium CNI";
task "install_cilium", sub {
    my $params = task_params(shift);
    my $distribution = $params->{distribution} || 'rke2';

    say "Installing Cilium CNI...";

    # Determine kubectl path
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';
    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';

    # Detect OS and Architecture
    my $os_raw = run "uname -s";
    chomp $os_raw;
    my $os = lc($os_raw);  # linux, darwin

    my $arch = _node_arch();

    # Install Cilium CLI (skip if already installed with correct version)
    my $cli_version = $params->{cli_version} // $ENV{OCP_CILIUM_CLI_VERSION}
        or die "OCP_CILIUM_CLI_VERSION (or task_params cli_version=...) is required\n";
    my $existing_cli = run "cilium version --client 2>/dev/null | head -1", auto_die => FALSE;
    chomp $existing_cli if defined $existing_cli;

    if ($existing_cli && $existing_cli =~ /\Q$cli_version\E/) {
        say "Cilium CLI $cli_version already installed";
    } else {
        say "Installing Cilium CLI $cli_version for $os-$arch...";
        my $cli_url = "https://github.com/cilium/cilium-cli/releases/download/$cli_version/cilium-$os-$arch.tar.gz";
        run "curl -fL $cli_url -o /tmp/cilium-cli.tar.gz 2>&1", auto_die => FALSE, timeout => 120;
        # Extract to /tmp first, then mv (atomic, avoids "Text file busy")
        run "tar xz -C /tmp -f /tmp/cilium-cli.tar.gz && mv -f /tmp/cilium /usr/local/bin/cilium && chmod +x /usr/local/bin/cilium", auto_die => FALSE;
        sleep 1;  # Let filesystem settle
        my $cli_installed = run "cilium version --client 2>&1 | head -1", auto_die => FALSE;
        say "Cilium CLI installed: $cli_installed";
    }

    # Install Gateway API CRDs BEFORE Cilium (required!)
    # The experimental channel is required, not optional: TLSRoute lives
    # only there, and Cilium lists it among the required resources.
    my $gateway_api_version = $params->{gateway_api_version} // $ENV{OCP_GATEWAY_API_VERSION}
        or die "OCP_GATEWAY_API_VERSION (or task_params gateway_api_version=...) is required\n";
    say "Installing Gateway API CRDs $gateway_api_version...";
    run "$kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/$gateway_api_version/standard-install.yaml",
        env => { KUBECONFIG => $kubeconfig };

    # Also install experimental CRDs (TCPRoute, UDPRoute, TLSRoute)
    run "$kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/$gateway_api_version/experimental-install.yaml",
        env => { KUBECONFIG => $kubeconfig },
        auto_die => FALSE;

    # Bounce cilium-operator if already running so it picks up the new CRD
    # schema (controller-runtime caches CRD schemas at startup; updating
    # Gateway API CRDs from v1.1 → v1.2 requires a restart for the
    # supportedFeatures object/string schema change to take effect).
    my $op_running = run "$kubectl -n kube-system get deployment cilium-operator -o name 2>/dev/null",
        env => { KUBECONFIG => $kubeconfig },
        auto_die => FALSE;
    if ($op_running && $op_running =~ /cilium-operator/) {
        say "Restarting cilium-operator to pick up updated CRD schema...";
        run "$kubectl -n kube-system rollout restart deployment cilium-operator",
            env => { KUBECONFIG => $kubeconfig },
            auto_die => FALSE;
    }

    # Install Cilium with Gateway API + LoadBalancer support (skip if already running with correct version)
    # NOTE: do NOT pipe to "head" — the version line ("Helm chart version: ...")
    # comes well below the status header. With head -5 the version check would
    # always be false on a healthy cluster, falsely triggering an upgrade run.
    my $cilium_version_target = $params->{version} // $ENV{OCP_CILIUM_VERSION}
        or die "OCP_CILIUM_VERSION (or task_params version=...) is required\n";
    my $cilium_status = run "cilium status 2>&1",
        env => { KUBECONFIG => $kubeconfig },
        auto_die => FALSE;

    my $cilium_running = ($cilium_status =~ /Cilium.*OK/);
    my $cilium_version_ok = ($cilium_status =~ /\Q$cilium_version_target\E/);

    if ($cilium_running && $cilium_version_ok) {
        say "Cilium $cilium_version_target already running, skipping install";
    } elsif ($cilium_running && !$cilium_version_ok) {
        say "Cilium running but different version, upgrading to $cilium_version_target...";
        run 'cilium upgrade --version ' . $cilium_version_target,
            env => { KUBECONFIG => $kubeconfig };
    } else {
        # cilium_running is false: either nothing installed OR a half-broken
        # state from a previous failed run. Clean any stale Helm release
        # record first, otherwise `cilium install` will silently exit 0
        # without doing anything because the CLI thinks the release exists.
        say "Cleaning any stale Cilium release before fresh install...";
        run "cilium uninstall --wait=false 2>&1",
            env => { KUBECONFIG => $kubeconfig },
            auto_die => FALSE;
        run "$kubectl -n kube-system delete secret -l name=cilium 2>&1",
            env => { KUBECONFIG => $kubeconfig },
            auto_die => FALSE;

        say "Installing Cilium $cilium_version_target with Gateway API...";
        run 'cilium install --version ' . $cilium_version_target . ' ' .
            '--set kubeProxyReplacement=true ' .
            '--set k8sServiceHost=localhost ' .
            '--set k8sServicePort=6443 ' .
            '--set gatewayAPI.enabled=true',
            env => { KUBECONFIG => $kubeconfig };

        # The cilium CLI is known to silently exit 0 in some failure modes
        # (e.g. stale Helm release records, version mismatches). Verify the
        # DaemonSet was actually created instead of trusting the exit code.
        say "Verifying Cilium DaemonSet was created...";
        my $ds_check = run "$kubectl -n kube-system get daemonset cilium -o name 2>&1",
            env => { KUBECONFIG => $kubeconfig },
            auto_die => FALSE;
        unless ($ds_check && $ds_check =~ m{daemonset\.apps/cilium}) {
            die "cilium install reported success but DaemonSet was not created.\n" .
                "kubectl output: " . ($ds_check // '(empty)') . "\n" .
                "Run 'cilium status' on the node to investigate.\n";
        }
        say "Cilium DaemonSet present: $ds_check";
    }

    # Wait for Cilium to be ready
    say "Waiting for Cilium to be ready...";
    run 'cilium status --wait --wait-duration=10m',
        env => { KUBECONFIG => $kubeconfig },
        timeout => 660;

    say "Cilium installed successfully";
};

#
# Update Tasks
#

desc "Upgrade Cilium to newer version";
task "upgrade_cilium", sub {
    my $params = task_params(shift);
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';

    say "Upgrading Cilium to $version...";

    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';

    # Update Cilium CLI (might be needed for newer versions)
    my $os_raw = run "uname -s";
    chomp $os_raw;
    my $os = lc($os_raw);

    my $arch = _node_arch();

    my $cli_version = $params->{cli_version} // $ENV{OCP_CILIUM_CLI_VERSION}
        or die "OCP_CILIUM_CLI_VERSION (or task_params cli_version=...) is required\n";
    my $cli_url = "https://github.com/cilium/cilium-cli/releases/download/$cli_version/cilium-$os-$arch.tar.gz";

    say "Updating Cilium CLI to $cli_version...";
    run "curl -sfL $cli_url | tar xz -C /usr/local/bin";
    run "chmod +x /usr/local/bin/cilium";

    # Upgrade Cilium in cluster
    say "Upgrading Cilium in cluster to $version...";
    run "cilium upgrade --version $version",
        env => { KUBECONFIG => $kubeconfig };

    # Wait for rollout
    say "Waiting for Cilium rollout...";
    run 'cilium status --wait --wait-duration=5m',
        env => { KUBECONFIG => $kubeconfig },
        timeout => 360;

    say "Cilium upgraded successfully to $version";
};

desc "Upgrade cert-manager to newer version";
task "upgrade_cert_manager", sub {
    my $params = task_params(shift);
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';

    say "Upgrading cert-manager to $version...";

    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';

    # cert-manager can be upgraded by applying new manifests
    my $url = "https://github.com/cert-manager/cert-manager/releases/download/$version/cert-manager.yaml";

    say "Applying cert-manager $version manifests...";
    run "$kubectl --kubeconfig=$kubeconfig apply -f $url";

    say "Waiting for cert-manager rollout...";
    run "$kubectl --kubeconfig=$kubeconfig wait --for=condition=Available " .
        "--timeout=300s deployment/cert-manager -n cert-manager";

    say "cert-manager upgraded successfully to $version";
};

1;
