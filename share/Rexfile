# RKE2 Tasks
#

desc "Install RKE2 server (control plane)";
task "install_rke2_server", sub {
    my $params = shift;
    my $token = $params->{token} || _generate_token();
    my $version = $params->{version} || '';
    my $tls_san = $params->{tls_san} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Create RKE2 config
    my $config = "cni: none\ndisable-kube-proxy: true\n";
    $config .= "token: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;
    $config .= "tls-san:\n  - $tls_san\n" if $tls_san;
    $config .= "disable:\n  - rke2-ingress-nginx\n";

    file "/etc/rancher/rke2", ensure => 'directory';
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Configure pull-through cache mirror for docker.io
    # containerd tries localhost:30500 first, falls back to docker.io if not yet running
    file "/etc/rancher/rke2/registries.yaml", content => <<'REGISTRIES';
mirrors:
  docker.io:
    endpoint:
      - "http://localhost:30500"
REGISTRIES

    # Configure containerd for NVIDIA GPU (if toolkit was installed by detect_gpu)
    _configure_nvidia_containerd();

    # Install RKE2
    say "[1/5] Installing RKE2...";

    # Pre-flight: verify connectivity to GitHub releases
    say "      Checking connectivity...";
    my $head_check = run "curl -sfI https://github.com/rancher/rke2/releases 2>&1 | head -1", auto_die => FALSE;
    chomp $head_check;
    say "      GitHub releases: $head_check";
    unless ($head_check =~ /200|301|302/) {
        die "Cannot reach GitHub releases - check network/DNS: $head_check";
    }

    # Download install script
    say "      Downloading install script...";
    run "curl -fL https://get.rke2.io -o /tmp/rke2-install.sh 2>&1", auto_die => FALSE;
    my $dl_size = run "wc -c < /tmp/rke2-install.sh 2>/dev/null || echo 0", auto_die => FALSE;
    chomp $dl_size;
    say "      Install script: $dl_size bytes";
    if ($dl_size < 1000) {
        die "Install script too small ($dl_size bytes) - download failed?";
    }

    # Pre-download RKE2 tarball (the install script uses curl -s which
    # produces no output, causing Rex to kill the SSH channel on timeout)
    say "      Detecting latest RKE2 version...";
    my $rke2_version = $version;
    if (!$rke2_version) {
        # Primary: channel server redirect (same method as official install script)
        $rke2_version = run "curl -sfL -w '%{url_effective}' -o /dev/null https://update.rke2.io/v1-release/channels/stable | sed 's|.*/||'",
            auto_die => FALSE;
        chomp $rke2_version if $rke2_version;

        # Fallback: parse JSON from channel server
        if (!$rke2_version) {
            say "      Channel redirect failed, trying JSON parse...";
            $rke2_version = run "curl -sfL https://update.rke2.io/v1-release/channels/stable 2>/dev/null | grep -oP '\"latest\"\\s*:\\s*\"\\K[^\"]+' || true",
                auto_die => FALSE;
            chomp $rke2_version if $rke2_version;
        }

        # Fallback 2: GitHub API
        if (!$rke2_version) {
            say "      Channel server unreachable, trying GitHub API...";
            $rke2_version = run "curl -sfL https://api.github.com/repos/rancher/rke2/releases/latest 2>/dev/null | grep -oP '\"tag_name\"\\s*:\\s*\"\\K[^\"]+' || true",
                auto_die => FALSE;
            chomp $rke2_version if $rke2_version;
        }
    }
    say "      RKE2 version: $rke2_version";

    if (!$rke2_version) {
        die "Could not detect RKE2 version - check DNS/network for update.rke2.io and api.github.com on this node";
    }

    my $version_url = $rke2_version;
    $version_url =~ s/\+/%2B/g;
    my $tarball_url = "https://github.com/rancher/rke2/releases/download/$version_url/rke2.linux-amd64.tar.gz";
    my $checksum_url = "https://github.com/rancher/rke2/releases/download/$version_url/sha256sum-amd64.txt";

    say "      Downloading RKE2 tarball (~60MB, this takes a moment)...";
    run "mkdir -p /tmp/rke2-artifacts", auto_die => FALSE;

    # Download with progress-bar so Rex sees output and doesn't kill the channel
    run "curl -fL --progress-bar -o /tmp/rke2-artifacts/rke2.linux-amd64.tar.gz '$tarball_url' 2>&1",
        auto_die => FALSE, timeout => 600;
    run "curl -fsSL -o /tmp/rke2-artifacts/sha256sum-amd64.txt '$checksum_url' 2>&1",
        auto_die => FALSE;

    # Verify download
    my $tarball_size = run "wc -c < /tmp/rke2-artifacts/rke2.linux-amd64.tar.gz 2>/dev/null || echo 0", auto_die => FALSE;
    chomp $tarball_size;
    say "      Tarball size: $tarball_size bytes";
    if ($tarball_size < 1000000) {
        die "RKE2 tarball too small ($tarball_size bytes) - download failed";
    }

    # Run install script pointing to our pre-downloaded artifacts
    say "      Running install script...";
    my $install_cmd = "INSTALL_RKE2_ARTIFACT_PATH=/tmp/rke2-artifacts ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$rke2_version " if $rke2_version;
    $install_cmd .= "sh /tmp/rke2-install.sh 2>&1; echo RKE2_EXIT_CODE=\$?";

    my $install_result = run $install_cmd, auto_die => FALSE, timeout => 120;
    say $install_result if $install_result;

    # Check explicit exit code from output
    my ($exit_code) = ($install_result || '') =~ /RKE2_EXIT_CODE=(\d+)/;
    $exit_code //= -1;
    say "      Install script exit code: $exit_code";

    # Verify installation - check multiple possible locations
    say "[2/5] Verifying RKE2 binary...";
    my $rke2_path = can_run("rke2");

    if (!$rke2_path) {
        # Check common paths explicitly
        my $search = run "ls -la /usr/local/bin/rke2* /usr/bin/rke2* /opt/rke2/bin/rke2* 2>&1 || true";
        say "=== Searching for RKE2 files ===";
        say $search;
        say "=== Install Output (if any) ===";
        say $install_result if $install_result;
        die "RKE2 binary missing - install may have failed";
    }
    say "RKE2 found at: $rke2_path";

    # Start service
    say "[3/5] Enabling and starting RKE2 service...";
    run "systemctl enable rke2-server.service 2>&1", auto_die => FALSE;
    run "systemctl start rke2-server.service 2>&1", auto_die => FALSE;

    # Wait for service to become active (up to 600s - VMs/slow machines need more time)
    say "[4/5] Waiting for RKE2 service to become active (up to 10 min)...";
    my $status;
    for my $i (1..60) {
        $status = run "systemctl is-active rke2-server.service", auto_die => FALSE;
        chomp $status;
        if ($status eq 'active') {
            say "      RKE2 service is active after ~" . ($i * 10) . "s";
            last;
        }
        if ($status eq 'failed' || $status eq 'inactive') {
            say "ERROR: rke2-server.service is $status!";
            my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
            say $journal;
            die "RKE2 server failed to start";
        }
        say "      ... still $status (${i}/60, " . ($i * 10) . "s)" if $i % 3 == 0;
        sleep 10;
    }

    if ($status ne 'active') {
        say "ERROR: rke2-server.service is not active after 600s! Status: $status";
        say "=== Service Status ===";
        my $full_status = run "systemctl status rke2-server.service --no-pager || true";
        say $full_status;
        say "=== Journal Logs (last 50 lines) ===";
        my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
        say $journal;
        say "=== End Logs ===";
        die "RKE2 server failed to start";
    }

    # Wait for kubeconfig to exist (max 60s)
    say "[5/5] Waiting for Kubernetes to initialize...";
    run "timeout 60 bash -c 'while [ ! -f /etc/rancher/rke2/rke2.yaml ]; do sleep 2; done' || true";

    # Check if it exists now
    if (!is_file("/etc/rancher/rke2/rke2.yaml")) {
        say "ERROR: kubeconfig not found after 60s!";
        say "=== Directory listing ===";
        my $ls = run "ls -la /etc/rancher/rke2/ || true";
        say $ls;
        say "=== Journal Logs ===";
        my $journal = run "journalctl -u rke2-server.service -n 100 --no-pager";
        say $journal;
        die "RKE2 kubeconfig not created";
    }

    # Wait for API to respond
    run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 5; done", timeout => 300;

    say "RKE2 cluster ready";

    # Return kubeconfig and token for OCP to store
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    say "KUBECONFIG_START";
    say $kubeconfig;
    say "KUBECONFIG_END";
    say "TOKEN: $token";
};

desc "Install RKE2 agent (worker)";
task "install_rke2_agent", sub {
    my $params = shift;
    my $server = $params->{server} or die "server URL required";
    my $token = $params->{token} or die "token required";
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Create RKE2 agent config
    my $config = "server: $server\ntoken: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;

    file "/etc/rancher/rke2", ensure => 'directory';
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Configure pull-through cache mirror for docker.io
    file "/etc/rancher/rke2/registries.yaml", content => <<'REGISTRIES';
mirrors:
  docker.io:
    endpoint:
      - "http://localhost:30500"
REGISTRIES

    # Configure containerd for NVIDIA GPU (if toolkit was installed by detect_gpu)
    _configure_nvidia_containerd();

    # Install RKE2 agent
    my $install_cmd = "curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE=agent ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$version " if $version;
    $install_cmd .= "sh -";

    run $install_cmd;

    # Start service
    run "systemctl enable rke2-agent.service";
    run "systemctl start rke2-agent.service";

    say "RKE2 agent joined cluster";
};

desc "Get RKE2 kubeconfig";
task "get_rke2_kubeconfig", sub {
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    return $kubeconfig;
};

desc "Get RKE2 token";
task "get_rke2_token", sub {
    my $token = run "cat /var/lib/rancher/rke2/server/node-token";
    chomp $token;
    return $token;
};

