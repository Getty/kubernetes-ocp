# OCP Rexfile - Server Automation Tasks
use Rex -feature => ['1.4'];
use Rex::Commands::Run;
use Rex::Commands::Fs;
use Rex::Commands::File;
use Rex::Commands::Service;
use Rex::Commands::Pkg;
use Rex::Commands::Host;
use JSON::MaybeXS;

# Authentication — Rex::Interface::Connection::LibSSH (Net::LibSSH).
# Pure libssh in-process: no ssh client subprocess, no SFTP subsystem,
# no ControlMaster sockets, no parsing of ~/.ssh/config. Host key checking
# is disabled inside the connection module itself.
set connection => 'LibSSH';
parallelism 1;

# SSH key from environment
if ($ENV{REX_PRIVATE_KEY}) {
    private_key $ENV{REX_PRIVATE_KEY};
    public_key $ENV{REX_PUBLIC_KEY} if $ENV{REX_PUBLIC_KEY};
    key_auth;
}

# Helper: Task parameters
#
# OCP::Rex hands parameters over as one JSON blob in REX_TASK_PARAMS rather
# than as CLI arguments. Reasons, in order of weight: secrets (the RKE2/K3s
# join token) stay out of the process command line where `ps` exposes them
# to every local user; nested structures survive; and the payload is
# generated by an encoder instead of assembled by hand.
#
# Rex's own `--key=value` form still wins when present, so every task stays
# runnable straight from the shell for debugging. Note the leading dashes —
# bare `key=value` is silently ignored by Rex, it never reaches the task.
sub task_params {
    my ($cli) = @_;

    return $cli if ref $cli eq 'HASH' && %$cli;
    return {} unless defined $ENV{REX_TASK_PARAMS} && length $ENV{REX_TASK_PARAMS};

    my $params = eval { JSON::MaybeXS->new(utf8 => 1)->decode($ENV{REX_TASK_PARAMS}) };
    die "REX_TASK_PARAMS is not valid JSON: $@" if $@;

    return ref $params eq 'HASH' ? $params : {};
}

# Helper: Check OS compatibility
sub check_os {
    my $os = operating_system();
    my $version = operating_system_version();

    say "Detected OS: $os $version";

    unless ($os eq 'Debian' || $os eq 'Ubuntu') {
        say "WARNING: This OS ($os) is not officially tested.";
        say "OCP is designed for Debian/Ubuntu. Proceed with caution.";
    }
}

# Helper: Go/Kubernetes architecture name of the target node
#
# Every upstream release artifact OCP downloads by hand — the RKE2 tarball,
# its checksum file, the Cilium CLI — is named after Go's GOARCH, not after
# `uname -m`. The mapping used to be inlined at the two Cilium call sites and
# was missing entirely at the RKE2 one, which hardcoded amd64 and therefore
# 404'd on every aarch64 node.
#
# Unknown machines fall through unmapped on purpose: a wrong-but-plausible
# guess would produce a 404 far from here, the raw name at least names itself
# in the failing URL.
sub _node_arch {
    my $raw = run "uname -m";
    chomp $raw if defined $raw;

    my %goarch = (
        x86_64  => 'amd64',
        amd64   => 'amd64',
        aarch64 => 'arm64',
        arm64   => 'arm64',
    );

    return $goarch{$raw} // $raw;
}

#
# Common Tasks
#

desc "Prepare node for Kubernetes";
task "prepare_node", sub {
    my $params = task_params(shift);
    my $hostname = $params->{hostname} || '';
    my $domain   = $params->{domain}   || '';
    my $timezone = $params->{timezone} || 'UTC';
    my $locale   = $params->{locale}   || 'en_US.UTF-8';
    my $ntp      = $params->{ntp}      // 1;

    check_os();

    # Refresh apt cache before any package install — on fresh Debian images
    # the cache is often stale, and the first real `apt-get install` will
    # silently fail. (curl/ca-certificates are already present so they
    # wouldn't trigger this, but chrony might.)
    say "Refreshing package database...";
    eval { update_package_db; 1 } or say "  update_package_db warning: $@";

    # Ensure required packages are installed
    pkg ["curl", "ca-certificates"], ensure => "present";

    # === Hostname ===
    if ($hostname) {
        say "Configuring hostname: $hostname" . ($domain ? ".$domain" : "");
        my $fqdn = $domain ? "$hostname.$domain" : $hostname;

        # hostnamectl (systemd) - fallback to /etc/hostname
        my $hc_out = run "which hostnamectl >/dev/null 2>&1 && hostnamectl set-hostname $hostname 2>&1", auto_die => FALSE;
        if ($? != 0) {
            file "/etc/hostname", content => "$hostname\n";
            run "hostname $hostname", auto_die => FALSE;
        }

        # /etc/hosts entry
        host_entry $fqdn,
            ensure  => "present",
            ip      => "127.0.1.1",
            aliases => [$hostname];
    }

    # === Timezone ===
    say "Configuring timezone: $timezone";
    my $tz_out = run "which timedatectl >/dev/null 2>&1 && timedatectl set-timezone $timezone 2>&1", auto_die => FALSE;
    if ($? != 0) {
        run "ln -sf /usr/share/zoneinfo/$timezone /etc/localtime", auto_die => FALSE;
        file "/etc/timezone", content => "$timezone\n";
    }

    # === Locale ===
    say "Configuring locale: $locale";
    run "which localectl >/dev/null 2>&1 && localectl set-locale LANG=$locale 2>&1", auto_die => FALSE;
    if ($? != 0) {
        file "/etc/default/locale", content => "LANG=$locale\n";
    }
    run "locale-gen $locale >/dev/null 2>&1", auto_die => FALSE;

    # === NTP ===
    # etcd/kube-apiserver need clock sync. Prefer what's already running:
    #   1. If timedatectl says "System clock synchronized: yes" → done
    #   2. Otherwise try chrony (best-effort, don't die — systemd-timesyncd
    #      may be active even if not yet "synchronized" from timedatectl's POV)
    if ($ntp) {
        my $tdc = run "timedatectl show --property=NTPSynchronized --value 2>/dev/null", auto_die => FALSE;
        chomp $tdc if defined $tdc;
        if (defined $tdc && $tdc eq 'yes') {
            say "NTP already synchronized (skipping chrony install)";
        } else {
            say "Ensuring NTP (chrony)...";
            eval { pkg ["chrony"], ensure => "present"; 1 };
            if (my $err = $@) {
                say "  chrony install failed: $err";
                say "  Checking systemd-timesyncd as fallback...";
                my $ts_active = run "systemctl is-active systemd-timesyncd 2>/dev/null", auto_die => FALSE;
                chomp $ts_active if defined $ts_active;
                if (defined $ts_active && $ts_active eq 'active') {
                    say "  [ok] systemd-timesyncd is active — using that";
                } else {
                    run "systemctl enable --now systemd-timesyncd 2>&1", auto_die => FALSE;
                    say "  (best-effort: started systemd-timesyncd)";
                }
            } else {
                run "systemctl enable --now chronyd 2>/dev/null || systemctl enable --now chrony 2>/dev/null", auto_die => FALSE;
            }
        }
    }

    # === Kubernetes preparation ===

    # Disable swap
    run "swapoff -a", auto_die => FALSE;
    delete_lines_matching "/etc/fstab", matching => qr/swap/;

    # Load kernel modules
    run "modprobe br_netfilter", auto_die => FALSE;
    run "modprobe overlay", auto_die => FALSE;

    file "/etc/modules-load.d/kubernetes.conf",
        content => "br_netfilter\noverlay\n";

    # Sysctl settings
    file "/etc/sysctl.d/99-kubernetes.conf",
        content => "net.bridge.bridge-nf-call-iptables = 1\nnet.bridge.bridge-nf-call-ip6tables = 1\nnet.ipv4.ip_forward = 1\n";

    run "sysctl --system > /dev/null 2>&1";

    # Every install task comes through here, for both distributions and both
    # roles, and it runs before the service is (re)started -- which is exactly
    # when an inherited containerd template still has a chance to be thrown
    # away instead of being rendered again. See the task itself for why this
    # is a content check and not an unlink.
    do_task "cleanup_legacy_containerd_template";
};

# Should this node get the host-side GPU treatment at all?
#
# Two spec keys, one question. `gpu.enabled: false` switches OCP's GPU handling
# off for the whole cluster, and `gpu.driver: operator` hands the driver *and*
# the container toolkit to the GPU Operator's DaemonSets — in both cases Rex
# has to keep its hands off the host.
#
# Missing parameters mean yes. robocop joins workers through the same tasks
# without passing either key, and a worker that quietly came up without its
# driver would be a worse failure than an ignored switch.
sub _maybe_detect_gpu {
    my ($params) = @_;

    unless ($params->{gpu} // 1) {
        say "GPU handling disabled (gpu.enabled: false) — skipping detection";
        return;
    }

    my $driver = $params->{gpu_driver} || 'host';
    unless ($driver eq 'host') {
        say "GPU driver mode '$driver' — the GPU Operator installs driver and toolkit, skipping host install";
        return;
    }

    do_task "detect_gpu";
}

desc "Detect NVIDIA GPU hardware and install drivers";
task "detect_gpu", sub {
    my @display = _pci_display_devices();

    say "=== Display Controllers ===";
    if (@display) {
        say "  $_->{slot}  $_->{vendor}:$_->{device}  class $_->{class}" for @display;
    } else {
        say "  (none found)";
    }
    say "=== End Display Controllers ===";

    my $action = _gpu_action(@display);

    if ($action eq 'nvidia') {
        my @nvidia = grep { $_->{vendor} eq '10de' } @display;
        say "NVIDIA GPU present: " . join(', ', map { "$_->{vendor}:$_->{device}" } @nvidia);
        do_task "install_nvidia";
    }
    elsif ($action eq 'virtual') {
        say "Virtual GPU only (virtio/QEMU/VMware/VBox) — no host driver needed";
    }
    elsif ($action eq 'amd') {
        say "AMD GPU detected — driver support not yet implemented";
    }
    else {
        say "No NVIDIA GPU found";
    }
};

# What should the bootstrap do about the display hardware it found?
# 'nvidia' (install the driver), 'virtual', 'amd' or 'none'.
#
# Before the cluster exists there is exactly one question worth asking: does
# this host need an NVIDIA driver? That is "NVIDIA hardware present" plus "no
# working driver yet", and install_nvidia answers the second half. Whether the
# card is worth scheduling on is decided later and elsewhere, by the device
# plugin publishing nvidia.com/gpu — not here by guessing at a model name.
sub _gpu_action {
    my (@display) = @_;

    # NVIDIA hardware settles it, and it is checked first on purpose: a VM with
    # a passed-through GPU has a virtio display adapter *and* the card, and
    # there the card wins. The virtual list only answers "nothing here needs a
    # host driver", which is only true when nothing else is here.
    return 'nvidia' if grep { $_->{vendor} eq '10de' } @display;

    # A short list of "definitely not" stays true as hardware moves on, which
    # is why this blacklist survives while the model whitelist did not.
    return 'virtual' if grep { $_->{vendor} =~ /^(?:1af4|1b36|15ad|80ee)$/ } @display;

    return 'amd' if grep { $_->{vendor} eq '1002' } @display;

    return 'none';
}

# Display and 3D controllers as the kernel reports them:
# { slot, vendor, device, class }, all lowercase hex without the 0x prefix.
#
# sysfs, not `lspci`. lspci prints the *name* it finds for a PCI ID in the
# host's pci.ids database, and that database is always older than the newest
# card — a DGX Spark prints `Device [10de:2e12]` for its GB10, which no list of
# marketing names can ever match. Vendor and class come from the hardware
# itself, need neither a database nor pciutils, and are precisely the pair NFD
# labels the node with in-cluster (feature.node.kubernetes.io/pci-0300_10de).
sub _pci_display_devices {
    my $raw = run
          q{for d in /sys/bus/pci/devices/*/; do }
        . q{test -r "$d/class" || continue; }
        . q{printf '%s|%s|%s|%s\n' "${d%/}" }
        . q{"$(cat "$d/vendor" 2>/dev/null)" }
        . q{"$(cat "$d/device" 2>/dev/null)" }
        . q{"$(cat "$d/class" 2>/dev/null)"; }
        . q{done},
        auto_die => FALSE;

    return () unless defined $raw;

    my @devices;
    for my $line (split /\n/, $raw) {
        my ($path, $vendor, $device, $class) = split /\|/, $line, 4;
        next unless defined $class;

        # 0x0300xx = VGA controller, 0x0302xx = 3D controller. The last byte is
        # the programming interface and is not part of the class we match on.
        my ($class_id)  = $class  =~ /^0x(0300|0302)[0-9a-f]{2}$/i or next;
        my ($vendor_id) = $vendor =~ /^0x([0-9a-f]{4})$/i          or next;
        my ($device_id) = $device =~ /^0x([0-9a-f]{4})$/i;

        my $slot = $path;
        $slot =~ s{.*/}{};

        push @devices, {
            slot   => $slot,
            vendor => lc $vendor_id,
            device => lc($device_id // '????'),
            class  => lc $class_id,
        };
    }

    return @devices;
}

desc "Install NVIDIA GPU drivers and container toolkit";
task "install_nvidia", sub {
    say "Installing NVIDIA GPU drivers and container toolkit...";

    my $os = operating_system();
    my $running_kernel = run "uname -r";
    chomp $running_kernel;
    say "  OS: $os, Kernel: $running_kernel";

    # 1. Install kernel headers + driver packages
    #
    # …unless the host already has a working one. Vendor appliances (NVIDIA
    # DGX and friends) ship with a driver matched to their kernel and their
    # silicon, often newer than anything in the distribution archive. Letting
    # apt pull some other branch over that downgrades a working machine into
    # a broken one, and on a fresh GPU generation there is no going back
    # without the vendor's image. A driver that answers `nvidia-smi` and
    # provides libcuda is the driver we want; OCP only needs the container
    # toolkit on top of it.
    if (_nvidia_driver_present()) {
        say "  Host driver already present and working — skipping driver install";
        say "  (OCP only adds the container toolkit on top of it)";
    } elsif ($os eq 'Debian') {
        # The kernel meta-package is named after the *Debian* architecture
        # (linux-headers-amd64, linux-headers-arm64, …), so ask dpkg rather
        # than assuming. GOARCH happens to agree for these two, but this is
        # dpkg's namespace, not Go's.
        my $deb_arch = run "dpkg --print-architecture";
        chomp $deb_arch if defined $deb_arch;
        $deb_arch ||= _node_arch();

        my @driver_packages = (
            "linux-headers-$running_kernel",  # DKMS builds for running kernel
            "linux-headers-$deb_arch",        # Meta for latest kernel
            "nvidia-driver",                  # Driver meta-package (pulls dkms)
            "nvidia-smi",                     # nvidia-smi tool
            "libcuda1",                       # CUDA driver library (needed by container runtime!)
        );

        say "  Installing driver packages...";
        update_package_db;
        pkg \@driver_packages, ensure => "present";
    } elsif ($os eq 'Ubuntu') {
        _install_nvidia_driver_ubuntu($running_kernel);
    } else {
        die "Unsupported OS for NVIDIA: $os\n";
    }

    # 2. Add NVIDIA container toolkit repo and install
    #
    # Same argument as the driver, one layer up: a vendor image already has the
    # toolkit — on a DGX Spark, /usr/bin/nvidia-container-runtime and nvidia-ctk
    # are there before OCP is. Adding NVIDIA's apt source to such a host changes
    # where its packages come from for everything that follows, for no gain, so
    # the presence of a working runtime ends this step too.
    if (_nvidia_toolkit_present()) {
        say "  Container toolkit already present — leaving the host's apt sources alone";
    } else {
        say "  Adding NVIDIA container toolkit repository...";
        pkg ["curl", "gnupg"], ensure => "present";

        # Download and dearmor GPG key (modern signed-by approach, not deprecated apt-key)
        run "curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg 2>/dev/null",
            auto_die => FALSE;

        # Write sources.list directly (not curl|sed pipeline)
        file "/etc/apt/sources.list.d/nvidia-container-toolkit.list",
            content => "deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://nvidia.github.io/libnvidia-container/stable/deb/\$(ARCH) /\n";

        update_package_db;

        say "  Installing nvidia-container-toolkit...";
        pkg ["nvidia-container-toolkit"], ensure => "present";
    }

    # 3. Load nvidia kernel module
    run "modprobe nvidia", auto_die => FALSE;

    # 4. Verify everything
    _verify_nvidia();

    say "NVIDIA GPU installation complete";
};

# Ubuntu: let `ubuntu-drivers` choose the driver package.
#
# Three questions decide which package is correct here, and OCP can answer none
# of them from the outside:
#
#   branch   `nvidia-driver-535` used to be hardcoded. R535 reached end of life
#            in June 2026, and on Ubuntu 24.04 the name now survives only as a
#            transitional package that pulls 580 — so the pin pinned nothing,
#            on amd64 just as much as on arm64.
#   flavour  Grace Hopper and Blackwell run *only* the open kernel modules; the
#            proprietary driver is unsupported on them (NVIDIA, "NVIDIA
#            Transitions Fully Towards Open-Source GPU Kernel Modules"). Maxwell,
#            Pascal and Volta are the other way round. `-open` is part of the
#            package name, so this is a naming decision, not a flag.
#   arch     amd64 and arm64 do not carry the same names, and on arm64 the
#            packages come from the ports archive.
#
# `ubuntu-drivers` answers all three from the card's PCI modalias — the same
# evidence NFD labels the node from — and it is what Ubuntu documents as the
# recommended installation path. It structurally cannot select a package that
# does not claim this card, which is the guarantee a literal package name never
# gives. A guessed name is how a working machine becomes a broken one, so OCP
# does not guess: if the tool is missing or fails, this dies and says so.
sub _install_nvidia_driver_ubuntu {
    my ($running_kernel) = @_;

    update_package_db;

    # Headers for the *running* kernel, and only those. `linux-headers-generic`
    # used to be in this list; it tracks the generic flavour, which on a vendor
    # kernel (a DGX Spark runs 6.17.0-1029-nvidia) is a different kernel
    # altogether — DKMS would build against headers the machine does not run.
    say "  Installing kernel headers for $running_kernel...";
    pkg ["linux-headers-$running_kernel"], ensure => "present";

    pkg ["ubuntu-drivers-common"], ensure => "present";

    my $listed = run "ubuntu-drivers list 2>&1", auto_die => FALSE;
    say "  ubuntu-drivers list:";
    say "    $_" for grep { length } split /\n/, ($listed // '(no output)');

    say "  Installing the recommended driver...";
    my $out = run "ubuntu-drivers install 2>&1", auto_die => FALSE;
    my $rc  = $?;
    say "    $_" for grep { length } split /\n/, ($out // '');

    if ($rc != 0) {
        die "ubuntu-drivers could not install a driver on this host.\n"
          . "OCP does not fall back to a guessed package name — the wrong branch\n"
          . "or the wrong kernel-module flavour breaks the machine. Install the\n"
          . "driver NVIDIA documents for this GPU and this kernel by hand, then\n"
          . "re-run: OCP skips the driver install once nvidia-smi answers.\n";
    }
}

# Is a working NVIDIA driver already installed on this host?
#
# "Working" is deliberately defined by what the container stack consumes, not
# by package state: nvidia-smi enumerates GPUs, and libcuda.so is in the
# linker cache. Package state would be the wrong question — vendor appliances
# install their driver outside the distribution's package namespace, so apt
# happily reports "not installed" for a machine that is running one.
sub _nvidia_driver_present {
    my $smi = run "nvidia-smi -L 2>&1", auto_die => FALSE;
    return 0 unless defined $smi && $smi =~ /GPU \d+:/;

    my $libcuda = run "ldconfig -p | grep 'libcuda.so '", auto_die => FALSE;
    unless (defined $libcuda && length $libcuda) {
        say "  nvidia-smi answers but libcuda.so is missing — driver is incomplete";
        return 0;
    }

    my $ver = run "nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1",
        auto_die => FALSE;
    chomp $ver if defined $ver;
    say "  Existing NVIDIA driver detected" . (($ver) ? " (version $ver)" : '');

    return 1;
}

# Is a usable NVIDIA container runtime already on this host?
#
# Same reasoning as _nvidia_driver_present: ask for the binaries the CRI
# actually execs, not for a package name. A DGX image installs both, and k3s
# and RKE2 find nvidia-container-runtime on PATH by themselves.
sub _nvidia_toolkit_present {
    return 0 unless can_run("nvidia-container-runtime");
    return 0 unless can_run("nvidia-ctk");
    say "  Existing NVIDIA container toolkit detected";
    return 1;
}

sub _verify_nvidia {
    say "  Verifying NVIDIA installation...";
    my $ok = 1;

    # Check kernel module loaded
    my $lsmod = run "lsmod | grep '^nvidia '", auto_die => FALSE;
    if ($? != 0 || !$lsmod) {
        say "  [WARN] nvidia kernel module not loaded (reboot may be needed)";
        my $dkms = run "dkms status 2>&1 | grep nvidia", auto_die => FALSE;
        say "         DKMS: $dkms" if $dkms;
        $ok = 0;
    } else {
        say "  [ok] nvidia kernel module loaded";
    }

    # Check nvidia-smi
    my $smi = run "nvidia-smi -L 2>&1", auto_die => FALSE;
    chomp $smi if defined $smi;
    if (defined $smi && $smi =~ /GPU \d+:/) {
        say "  [ok] $smi";
    } else {
        say "  [WARN] nvidia-smi not working: " . ($smi // 'no output');
        $ok = 0;
    }

    # Check libcuda
    my $libcuda = run "ldconfig -p | grep 'libcuda.so '", auto_die => FALSE;
    if ($? == 0 && $libcuda) {
        say "  [ok] libcuda available";
    } else {
        say "  [WARN] libcuda.so not found";
        $ok = 0;
    }

    # Check container toolkit
    if (can_run("nvidia-ctk")) {
        say "  [ok] nvidia-container-toolkit installed";
    } else {
        say "  [WARN] nvidia-container-toolkit not found";
        $ok = 0;
    }

    unless ($ok) {
        say "  [WARN] GPU verification incomplete - some features may not work until reboot";
    }
}

#
# RKE2 Tasks
#

desc "Install RKE2 server (control plane)";
task "install_rke2_server", sub {
    my $params = task_params(shift);
    my $token = $params->{token} || _generate_token();
    my $version = $params->{version} || '';
    my $tls_san = $params->{tls_san} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node", {
        hostname => $params->{hostname} || '',
        domain   => $params->{domain}   || '',
        timezone => $params->{timezone} || 'UTC',
        locale   => $params->{locale}   || 'en_US.UTF-8',
        ntp      => $params->{ntp}      // 1,
    };
    _maybe_detect_gpu($params);

    # Create RKE2 config
    my $config = "cni: none\ndisable-kube-proxy: true\n";
    $config .= "token: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;
    $config .= "tls-san:\n  - $tls_san\n" if $tls_san;
    # Disable every bundled ingress controller — Cilium Gateway API is the
    # ingress here. RKE2 v1.36 added Traefik on top of ingress-nginx, and its
    # helm-install job CrashLoopBackOffs against a Cilium-owned cluster
    # ("Required CRDs are missing"), so name both plus the CRD chart.
    $config .= "disable:\n";
    $config .= "  - $_\n" for qw(
        rke2-ingress-nginx
        rke2-traefik
        rke2-traefik-crd
    );

    file "/etc/rancher/rke2", ensure => 'directory';
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Configure registry mirrors (pull-through cache + internal registry name)
    my $registries = _generate_registries_yaml(
        registry_cache    => $params->{registry_cache}    || '',
        registry_upstream => $params->{registry_upstream}  || '',
        registry_name     => $params->{registry_name}      || 'ocp.internal',
    );
    file "/etc/rancher/rke2/registries.yaml", content => $registries;

    # RKE2 looks for alternative container runtimes on the service PATH, and
    # its unit sets none. Must happen before the service starts: the scan runs
    # at startup only.
    _configure_nvidia_runtime_path('rke2-server');

    # Install RKE2
    say "[1/5] Installing RKE2...";

    # Pre-flight: verify connectivity to GitHub releases
    say "      Checking connectivity...";
    my $head_check = run "curl -sfI https://github.com/rancher/rke2/releases 2>&1 | head -1", auto_die => FALSE;
    chomp $head_check;
    say "      GitHub releases: $head_check";
    unless ($head_check =~ /200|301|302/) {
        die "Cannot reach GitHub releases - check network/DNS: $head_check";
    }

    # Download install script
    say "      Downloading install script...";
    run "curl -fL https://get.rke2.io -o /tmp/rke2-install.sh 2>&1", auto_die => FALSE;
    my $dl_size = run "wc -c < /tmp/rke2-install.sh 2>/dev/null || echo 0", auto_die => FALSE;
    chomp $dl_size;
    say "      Install script: $dl_size bytes";
    if ($dl_size < 1000) {
        die "Install script too small ($dl_size bytes) - download failed?";
    }

    # Pre-download RKE2 tarball (the install script uses curl -s which
    # produces no output, causing Rex to kill the SSH channel on timeout)
    say "      Detecting latest RKE2 version...";
    my $rke2_version = $version;
    if (!$rke2_version) {
        # Primary: channel server redirect (same method as official install script)
        $rke2_version = run "curl -sfL -w '%{url_effective}' -o /dev/null https://update.rke2.io/v1-release/channels/stable | sed 's|.*/||'",
            auto_die => FALSE;
        chomp $rke2_version if $rke2_version;

        # Fallback: parse JSON from channel server
        if (!$rke2_version) {
            say "      Channel redirect failed, trying JSON parse...";
            $rke2_version = run "curl -sfL https://update.rke2.io/v1-release/channels/stable 2>/dev/null | grep -oP '\"latest\"\\s*:\\s*\"\\K[^\"]+' || true",
                auto_die => FALSE;
            chomp $rke2_version if $rke2_version;
        }

        # Fallback 2: GitHub API
        if (!$rke2_version) {
            say "      Channel server unreachable, trying GitHub API...";
            $rke2_version = run "curl -sfL https://api.github.com/repos/rancher/rke2/releases/latest 2>/dev/null | grep -oP '\"tag_name\"\\s*:\\s*\"\\K[^\"]+' || true",
                auto_die => FALSE;
            chomp $rke2_version if $rke2_version;
        }
    }
    say "      RKE2 version: $rke2_version";

    if (!$rke2_version) {
        die "Could not detect RKE2 version - check DNS/network for update.rke2.io and api.github.com on this node";
    }

    my $version_url = $rke2_version;
    $version_url =~ s/\+/%2B/g;

    # The install script names its artifacts by GOARCH and refuses anything
    # else in INSTALL_RKE2_ARTIFACT_PATH — the tarball and the checksum file
    # must carry the node's own architecture, not the build host's.
    my $arch = _node_arch();
    say "      Node architecture: $arch";

    my $tarball_name  = "rke2.linux-$arch.tar.gz";
    my $checksum_name = "sha256sum-$arch.txt";
    my $tarball_url = "https://github.com/rancher/rke2/releases/download/$version_url/$tarball_name";
    my $checksum_url = "https://github.com/rancher/rke2/releases/download/$version_url/$checksum_name";

    say "      Downloading RKE2 tarball (~60MB, this takes a moment)...";
    run "mkdir -p /tmp/rke2-artifacts", auto_die => FALSE;

    # Download with progress-bar so Rex sees output and doesn't kill the channel
    run "curl -fL --progress-bar -o /tmp/rke2-artifacts/$tarball_name '$tarball_url' 2>&1",
        auto_die => FALSE, timeout => 600;
    run "curl -fsSL -o /tmp/rke2-artifacts/$checksum_name '$checksum_url' 2>&1",
        auto_die => FALSE;

    # Verify download
    my $tarball_size = run "wc -c < /tmp/rke2-artifacts/$tarball_name 2>/dev/null || echo 0", auto_die => FALSE;
    chomp $tarball_size;
    say "      Tarball size: $tarball_size bytes";
    if ($tarball_size < 1000000) {
        die "RKE2 tarball too small ($tarball_size bytes) - download failed.\n" .
            "URL was: $tarball_url\n" .
            "If that 404s, RKE2 $rke2_version publishes no build for '$arch'.\n";
    }

    # Run install script pointing to our pre-downloaded artifacts
    say "      Running install script...";
    my $install_cmd = "INSTALL_RKE2_ARTIFACT_PATH=/tmp/rke2-artifacts ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$rke2_version " if $rke2_version;
    $install_cmd .= "sh /tmp/rke2-install.sh 2>&1; echo RKE2_EXIT_CODE=\$?";

    my $install_result = run $install_cmd, auto_die => FALSE, timeout => 120;
    say $install_result if $install_result;

    # Check explicit exit code from output
    my ($exit_code) = ($install_result || '') =~ /RKE2_EXIT_CODE=(\d+)/;
    $exit_code //= -1;
    say "      Install script exit code: $exit_code";

    # Verify installation - check multiple possible locations
    say "[2/5] Verifying RKE2 binary...";
    my $rke2_path = can_run("rke2");

    if (!$rke2_path) {
        # Check common paths explicitly
        my $search = run "ls -la /usr/local/bin/rke2* /usr/bin/rke2* /opt/rke2/bin/rke2* 2>&1 || true";
        say "=== Searching for RKE2 files ===";
        say $search;
        say "=== Install Output (if any) ===";
        say $install_result if $install_result;
        die "RKE2 binary missing - install may have failed";
    }
    say "RKE2 found at: $rke2_path";

    # Start service
    say "[3/5] Enabling and starting RKE2 service...";
    run "systemctl enable rke2-server.service 2>&1", auto_die => FALSE;
    run "systemctl start rke2-server.service 2>&1", auto_die => FALSE;

    # Wait for service to become active (up to 600s - VMs/slow machines need more time)
    say "[4/5] Waiting for RKE2 service to become active (up to 10 min)...";
    my $status;
    for my $i (1..60) {
        $status = run "systemctl is-active rke2-server.service", auto_die => FALSE;
        chomp $status;
        if ($status eq 'active') {
            say "      RKE2 service is active after ~" . ($i * 10) . "s";
            last;
        }
        if ($status eq 'failed' || $status eq 'inactive') {
            say "ERROR: rke2-server.service is $status!";
            my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
            say $journal;
            die "RKE2 server failed to start";
        }
        say "      ... still $status (${i}/60, " . ($i * 10) . "s)" if $i % 3 == 0;
        sleep 10;
    }

    if ($status ne 'active') {
        say "ERROR: rke2-server.service is not active after 600s! Status: $status";
        say "=== Service Status ===";
        my $full_status = run "systemctl status rke2-server.service --no-pager || true";
        say $full_status;
        say "=== Journal Logs (last 50 lines) ===";
        my $journal = run "journalctl -u rke2-server.service -n 50 --no-pager || true";
        say $journal;
        say "=== End Logs ===";
        die "RKE2 server failed to start";
    }

    # Wait for kubeconfig to exist (max 60s)
    say "[5/5] Waiting for Kubernetes to initialize...";
    run "timeout 60 bash -c 'while [ ! -f /etc/rancher/rke2/rke2.yaml ]; do sleep 2; done' || true";

    # Check if it exists now
    if (!is_file("/etc/rancher/rke2/rke2.yaml")) {
        say "ERROR: kubeconfig not found after 60s!";
        say "=== Directory listing ===";
        my $ls = run "ls -la /etc/rancher/rke2/ || true";
        say $ls;
        say "=== Journal Logs ===";
        my $journal = run "journalctl -u rke2-server.service -n 100 --no-pager";
        say $journal;
        die "RKE2 kubeconfig not created";
    }

    # Wait for API to respond
    run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 5; done", timeout => 300;

    say "RKE2 cluster ready";
};

desc "Install RKE2 agent (worker)";
task "install_rke2_agent", sub {
    my $params = task_params(shift);
    my $server = $params->{server} or die "server URL required";
    my $token = $params->{token} or die "token required";
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node", {
        hostname => $params->{hostname} || '',
        domain   => $params->{domain}   || '',
        timezone => $params->{timezone} || 'UTC',
        locale   => $params->{locale}   || 'en_US.UTF-8',
        ntp      => $params->{ntp}      // 1,
    };
    _maybe_detect_gpu($params);

    # Create RKE2 agent config
    my $config = "server: $server\ntoken: $token\n";
    $config .= "node-name: $node_name\n" if $node_name;

    file "/etc/rancher/rke2", ensure => 'directory';
    file "/etc/rancher/rke2/config.yaml", content => $config;

    # Configure registry mirrors (pull-through cache + internal registry name)
    my $registries = _generate_registries_yaml(
        registry_cache    => $params->{registry_cache}    || '',
        registry_upstream => $params->{registry_upstream}  || '',
        registry_name     => $params->{registry_name}      || 'ocp.internal',
    );
    file "/etc/rancher/rke2/registries.yaml", content => $registries;

    # See install_rke2_server: the runtime scan happens at service startup, so
    # the PATH has to be in place before the agent is installed.
    _configure_nvidia_runtime_path('rke2-agent');

    # Install RKE2 agent
    my $install_cmd = "curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE=agent ";
    $install_cmd .= "INSTALL_RKE2_VERSION=$version " if $version;
    $install_cmd .= "sh -";

    run $install_cmd;

    # Start service
    run "systemctl enable rke2-agent.service";
    run "systemctl start rke2-agent.service";

    say "RKE2 agent joined cluster";
};

desc "Get RKE2 kubeconfig";
task "get_rke2_kubeconfig", sub {
    my $kubeconfig = run "cat /etc/rancher/rke2/rke2.yaml";
    return $kubeconfig;
};

