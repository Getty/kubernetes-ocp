desc "Install K3s server (control plane)";
task "install_k3s_server", sub {
    my $params = shift;
    my $token = $params->{token} || _generate_token();
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Install K3s
    my $install_cmd = "curl -sfL https://get.k3s.io | ";
    $install_cmd .= "INSTALL_K3S_VERSION=$version " if $version;
    $install_cmd .= "K3S_TOKEN=$token ";
    $install_cmd .= "K3S_NODE_NAME=$node_name " if $node_name;
    $install_cmd .= "sh -s - server --disable=traefik --disable=servicelb --write-kubeconfig-mode=644";

    run $install_cmd;

    # Wait for ready
    say "Waiting for K3s to be ready...";
    run "while ! kubectl get nodes 2>/dev/null; do sleep 5; done", timeout => 300;

    say "K3s server ready";
};

desc "Install K3s agent (worker)";
task "install_k3s_agent", sub {
    my $params = shift;
    my $server = $params->{server} or die "server URL required";
    my $token = $params->{token} or die "token required";
    my $version = $params->{version} || '';
    my $node_name = $params->{node_name} || '';

    do_task "prepare_node";
    do_task "detect_gpu";

    # Install K3s agent
    my $install_cmd = "curl -sfL https://get.k3s.io | ";
    $install_cmd .= "INSTALL_K3S_VERSION=$version " if $version;
    $install_cmd .= "K3S_URL=$server K3S_TOKEN=$token ";
    $install_cmd .= "K3S_NODE_NAME=$node_name " if $node_name;
    $install_cmd .= "sh -s - agent";

    run $install_cmd;

    say "K3s agent joined cluster";
};

desc "Get K3s kubeconfig";
task "get_k3s_kubeconfig", sub {
    my $kubeconfig = run "cat /etc/rancher/k3s/k3s.yaml";
    return $kubeconfig;
};

desc "Get K3s token";
task "get_k3s_token", sub {
    my $token = run "cat /var/lib/rancher/k3s/server/node-token";
    chomp $token;
    return $token;
};

#
# Single-Node Tasks
#

desc "Untaint control plane (allow workloads)";
task "untaint_control_plane", sub {
    my $params = shift;
    my $distribution = $params->{distribution} || 'rke2';

    say "Removing control plane taints...";

    if ($distribution eq 'rke2') {
        # Wait for node to be registered
        run "while ! /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do sleep 2; done", timeout => 60;

        # Get node name
        my $node = run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath='{.items[0].metadata.name}'";
        chomp $node;

        # Remove taints
        run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml taint nodes $node node-role.kubernetes.io/control-plane:NoSchedule- || true";
        run "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml taint nodes $node node-role.kubernetes.io/master:NoSchedule- || true";
    } else {
        # K3s
        run "while ! kubectl get nodes 2>/dev/null; do sleep 2; done", timeout => 60;

        my $node = run "kubectl get nodes -o jsonpath='{.items[0].metadata.name}'";
        chomp $node;

        run "kubectl taint nodes $node node-role.kubernetes.io/control-plane:NoSchedule- || true";
        run "kubectl taint nodes $node node-role.kubernetes.io/master:NoSchedule- || true";
    }

    say "Control plane untainted, workloads can be scheduled";
};

#
# Helpers
#

sub _generate_token {
    my $token = run "head -c 48 /dev/urandom | base64 | tr -d '\\n+/='";
    chomp $token;
    return substr($token, 0, 48);
}

sub _configure_nvidia_containerd {
    return unless can_run("nvidia-container-runtime");

    say "Configuring RKE2 containerd for NVIDIA GPU...";

    # Create RKE2 containerd config template with import for nvidia config
    file "/var/lib/rancher/rke2/agent/etc/containerd", ensure => 'directory';
    file "/var/lib/rancher/rke2/agent/etc/containerd/config.toml.tmpl",
        content => "imports = [\"/etc/containerd/conf.d/*.toml\"]\nversion = 2\n";

    # Create nvidia containerd runtime config
    file "/etc/containerd/conf.d", ensure => 'directory';
    file "/etc/containerd/conf.d/99-nvidia.toml", content => <<'TOML';
version = 2

[plugins]
  [plugins."io.containerd.grpc.v1.cri"]
    [plugins."io.containerd.grpc.v1.cri".containerd]
      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes]
        [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.nvidia]
          privileged_without_host_devices = false
          runtime_engine = ""
          runtime_root = ""
          runtime_type = "io.containerd.runc.v2"
          [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.nvidia.options]
            BinaryName = "/usr/bin/nvidia-container-runtime"
TOML

    say "  [ok] containerd configured with nvidia runtime";
}

#
# Cilium Tasks
#

# Cilium versions (keep in sync!)
use constant CILIUM_VERSION     => '1.17.0';
use constant CILIUM_CLI_VERSION => 'v0.16.23';

desc "Install Cilium CNI";
task "install_cilium", sub {
    my $params = shift;
    my $distribution = $params->{distribution} || 'rke2';

    say "Installing Cilium CNI...";

    # Determine kubectl path
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';
    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';

    # Detect OS and Architecture
    my $os_raw = run "uname -s";
    chomp $os_raw;
    my $os = lc($os_raw);  # linux, darwin

    my $arch_raw = run "uname -m";
    chomp $arch_raw;
    # Map architecture names
    my $arch = $arch_raw eq 'x86_64'  ? 'amd64' :
               $arch_raw eq 'aarch64' ? 'arm64' :
               $arch_raw eq 'arm64'   ? 'arm64' : $arch_raw;

    # Install Cilium CLI (skip if already installed with correct version)
    my $cli_version = CILIUM_CLI_VERSION;
    my $existing_cli = run "cilium version --client 2>/dev/null | head -1", auto_die => FALSE;
    chomp $existing_cli if defined $existing_cli;

    if ($existing_cli && $existing_cli =~ /\Q$cli_version\E/) {
        say "Cilium CLI $cli_version already installed";
    } else {
        say "Installing Cilium CLI $cli_version for $os-$arch...";
        my $cli_url = "https://github.com/cilium/cilium-cli/releases/download/$cli_version/cilium-$os-$arch.tar.gz";
        run "curl -fL $cli_url -o /tmp/cilium-cli.tar.gz 2>&1", auto_die => FALSE, timeout => 120;
        # Extract to /tmp first, then mv (atomic, avoids "Text file busy")
        run "tar xz -C /tmp -f /tmp/cilium-cli.tar.gz && mv -f /tmp/cilium /usr/local/bin/cilium && chmod +x /usr/local/bin/cilium", auto_die => FALSE;
        sleep 1;  # Let filesystem settle
        my $cli_installed = run "cilium version --client 2>&1 | head -1", auto_die => FALSE;
        say "Cilium CLI installed: $cli_installed";
    }

    # Install Gateway API CRDs BEFORE Cilium (required!)
    say "Installing Gateway API CRDs v1.1.0...";
    run "$kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.1.0/standard-install.yaml",
        env => { KUBECONFIG => $kubeconfig };

    # Also install experimental CRDs (TCPRoute, UDPRoute, TLSRoute)
    run "$kubectl apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.1.0/experimental-install.yaml",
        env => { KUBECONFIG => $kubeconfig },
        auto_die => FALSE;

    # Install Cilium with Gateway API + LoadBalancer support (skip if already running with correct version)
    my $cilium_version_target = CILIUM_VERSION;
    my $cilium_status = run "cilium status 2>&1 | head -5",
        env => { KUBECONFIG => $kubeconfig },
        auto_die => FALSE;

    my $cilium_running = ($cilium_status =~ /Cilium.*OK/);
    my $cilium_version_ok = ($cilium_status =~ /\Q$cilium_version_target\E/);

    if ($cilium_running && $cilium_version_ok) {
        say "Cilium $cilium_version_target already running, skipping install";
    } elsif ($cilium_running && !$cilium_version_ok) {
        say "Cilium running but different version, upgrading to $cilium_version_target...";
        run 'cilium upgrade --version ' . CILIUM_VERSION,
            env => { KUBECONFIG => $kubeconfig };
    } else {
        say "Installing Cilium " . CILIUM_VERSION . " with Gateway API...";
        run 'cilium install --version ' . CILIUM_VERSION . ' ' .
            '--set kubeProxyReplacement=true ' .
            '--set k8sServiceHost=localhost ' .
            '--set k8sServicePort=6443 ' .
            '--set gatewayAPI.enabled=true',
            env => { KUBECONFIG => $kubeconfig };
    }

    # Wait for Cilium to be ready
    say "Waiting for Cilium to be ready...";
    run 'cilium status --wait --wait-duration=10m',
        env => { KUBECONFIG => $kubeconfig },
        timeout => 660;

    say "Cilium installed successfully";
};

#
# Update Tasks
#

desc "Upgrade Cilium to newer version";
task "upgrade_cilium", sub {
    my $params = shift;
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';

    say "Upgrading Cilium to $version...";

    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';

    # Update Cilium CLI (might be needed for newer versions)
    my $os_raw = run "uname -s";
    chomp $os_raw;
    my $os = lc($os_raw);

    my $arch_raw = run "uname -m";
    chomp $arch_raw;
    my $arch = $arch_raw eq 'x86_64'  ? 'amd64' :
               $arch_raw eq 'aarch64' ? 'arm64' :
               $arch_raw eq 'arm64'   ? 'arm64' : $arch_raw;

    my $cli_version = $params->{cli_version} || CILIUM_CLI_VERSION;
    my $cli_url = "https://github.com/cilium/cilium-cli/releases/download/$cli_version/cilium-$os-$arch.tar.gz";

    say "Updating Cilium CLI to $cli_version...";
    run "curl -sfL $cli_url | tar xz -C /usr/local/bin";
    run "chmod +x /usr/local/bin/cilium";

    # Upgrade Cilium in cluster
    say "Upgrading Cilium in cluster to $version...";
    run "cilium upgrade --version $version",
        env => { KUBECONFIG => $kubeconfig };

    # Wait for rollout
    say "Waiting for Cilium rollout...";
    run 'cilium status --wait --wait-duration=5m',
        env => { KUBECONFIG => $kubeconfig },
        timeout => 360;

    say "Cilium upgraded successfully to $version";
};

desc "Upgrade cert-manager to newer version";
task "upgrade_cert_manager", sub {
    my $params = shift;
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';

    say "Upgrading cert-manager to $version...";

    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';

    # cert-manager can be upgraded by applying new manifests
    my $url = "https://github.com/cert-manager/cert-manager/releases/download/$version/cert-manager.yaml";

    say "Applying cert-manager $version manifests...";
    run "$kubectl --kubeconfig=$kubeconfig apply -f $url";

    say "Waiting for cert-manager rollout...";
    run "$kubectl --kubeconfig=$kubeconfig wait --for=condition=Available " .
        "--timeout=300s deployment/cert-manager -n cert-manager";

    say "cert-manager upgraded successfully to $version";
};

1;
