desc "Upgrade cert-manager to newer version";
task "upgrade_cert_manager", sub {
    my $params = shift;
    my $version = $params->{version} or die "version parameter required\n";
    my $distribution = $params->{distribution} || 'rke2';

    say "Upgrading cert-manager to $version...";

    my $kubeconfig = $distribution eq 'k3s' ? '/etc/rancher/k3s/k3s.yaml' : '/etc/rancher/rke2/rke2.yaml';
    my $kubectl = $distribution eq 'k3s' ? 'kubectl' : '/var/lib/rancher/rke2/bin/kubectl';

    # cert-manager can be upgraded by applying new manifests
    my $url = "https://github.com/cert-manager/cert-manager/releases/download/$version/cert-manager.yaml";

    say "Applying cert-manager $version manifests...";
    run "$kubectl --kubeconfig=$kubeconfig apply -f $url";

    say "Waiting for cert-manager rollout...";
    run "$kubectl --kubeconfig=$kubeconfig wait --for=condition=Available " .
        "--timeout=300s deployment/cert-manager -n cert-manager";

    say "cert-manager upgraded successfully to $version";
};

1;
