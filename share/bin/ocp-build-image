#!/usr/bin/env bash
#
# ocp-build-image — Build and (optionally) push the OCP Docker image to a
# registry. The image is built for the architecture of the machine running
# this script. Idempotent, CI-friendly. Standalone — works without `make` or
# any Perl.
#
# Tags written (in order):
#   latest
#   $VERSION            — from ./VERSION file, --tag=…, or `git describe`
#   <git-sha-short-7>   — from `git rev-parse --short=7 HEAD`
#
# Push target: raudssus/ocp by default; override via --repo= or $OCP_IMAGE_REPO.
#
# Build cache: pulled from $REPO:cache so incremental builds reuse layers
# (push from CI; local-only builds still benefit if the cache tag exists).
#
set -euo pipefail

# ---- Defaults ---------------------------------------------------------------
REPO="${OCP_IMAGE_REPO:-raudssus/ocp}"
PUSH=1
DRY_RUN=0
TAG_OVERRIDE=""

# ---- Usage ------------------------------------------------------------------
usage() {
    cat <<'EOF'
ocp-build-image — Build and (optionally) push the OCP Docker image

Builds for the architecture of the machine this runs on.

Usage:
  ocp-build-image [options]

Options:
  --repo=NAME         Image repo (default: raudssus/ocp, or $OCP_IMAGE_REPO)
  --tag=VERSION       Override VERSION (otherwise from ./VERSION or git describe)
  --push              Push to registry (default)
  --no-push           Build only, do not push
  --dry-run           Print docker commands instead of running them
  -h, --help          Show this help

Environment:
  OCP_IMAGE_REPO        Default --repo value

Exit codes:
  0  success
  1  build failed
  2  push failed
  3  not logged in to a docker registry
EOF
}

# ---- Argument parsing --------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo=*)      REPO="${1#*=}" ;;
        --tag=*)       TAG_OVERRIDE="${1#*=}" ;;
        --push)        PUSH=1 ;;
        --no-push)     PUSH=0 ;;
        --dry-run)     DRY_RUN=1 ;;
        -h|--help)     usage; exit 0 ;;
        --)            shift; break ;;
        -*)
            echo "ocp-build-image: unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            echo "ocp-build-image: unexpected argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

# ---- Helpers -----------------------------------------------------------------

log()  { printf '[ocp-build-image] %s\n' "$*"; }
errl() { printf '[ocp-build-image] %s\n' "$*" >&2; }

# Resolve VERSION: --tag override > ./VERSION file > git describe > develop.
# The git fallback never crashes the script — `git describe` returns non-zero
# outside a git repo or with no tags, and the `||` catches both.
get_version() {
    if [[ -n "$TAG_OVERRIDE" ]]; then
        printf '%s' "$TAG_OVERRIDE"
    elif [[ -f ./VERSION ]]; then
        cat ./VERSION
    elif git describe --tags --always >/dev/null 2>&1; then
        git describe --tags --always
    else
        printf 'develop'
    fi
}

# Verify docker login. `docker info` reports "Username: …" when authenticated
# against Docker Hub; for other registries we look at ~/.docker/config.json.
# Skipped entirely in --dry-run mode (the test sandbox has no docker login).
check_login() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        return 0
    fi
    if docker info 2>/dev/null | grep -q '^Username:'; then
        return 0
    fi
    local cfg="${DOCKER_CONFIG:-$HOME/.docker}/config.json"
    if [[ -f "$cfg" ]] \
        && grep -q '"auths"' "$cfg" 2>/dev/null \
        && [[ -s "$cfg" ]]; then
        return 0
    fi
    errl "not logged in to a docker registry"
    errl "  hint: docker login  (or docker login ghcr.io / registry.gitlab.com)"
    return 3
}

# Quote a value for the --dry-run output. Single-quote escaping keeps commas
# (--cache-from) intact rather than escaping them the way `%q` does.
shq() {
    # Single-quote-escape a value: ' → '\''
    local v="${1-}"
    v="${v//\'/\'\\\'\'}"
    printf "'%s'" "$v"
}

# Print the docker commands --dry-run would have run: one build, then one
# push per tag.
dry_run_lines() {
    printf '[dry-run] docker build'
    for tag in "${TAGS[@]}"; do
        printf ' -t %s' "$(shq "$REPO:$tag")"
    done
    printf ' --cache-from %s' "$(shq "type=registry,ref=$REPO:cache")"
    printf ' .\n'
    if [[ "$PUSH" -eq 1 ]]; then
        for tag in "${TAGS[@]}"; do
            printf '[dry-run] docker push %s\n' "$(shq "$REPO:$tag")"
        done
    fi
}

# Build the image for this machine's architecture. Exit code 1 is reserved for
# a failing build; docker's own output goes straight to the terminal.
run_build() {
    local -a cmd=( docker build )
    for tag in "${TAGS[@]}"; do
        cmd+=( -t "$REPO:$tag" )
    done
    cmd+=( --cache-from "type=registry,ref=$REPO:cache" . )

    if ! "${cmd[@]}"; then
        errl "build failed"
        return 1
    fi
}

# Push every tag. Separate step from the build, so a failure here is
# unambiguously a push failure (exit 2) and never a build failure.
run_push() {
    for tag in "${TAGS[@]}"; do
        if ! docker push "$REPO:$tag"; then
            errl "push failed: $REPO:$tag"
            return 2
        fi
    done
}

# ---- Resolve tags ------------------------------------------------------------
VERSION="$(get_version)"
if git rev-parse --short=7 HEAD >/dev/null 2>&1; then
    GIT_SHA="$(git rev-parse --short=7 HEAD)"
else
    GIT_SHA="unknown"
fi

# Tag order is part of the contract: the script's docs and the test suite
# rely on this exact triple.
TAGS=( "latest" "$VERSION" "$GIT_SHA" )

# ---- Main --------------------------------------------------------------------
main() {
    log "repo=$REPO push=$PUSH"
    log "tags=${TAGS[*]}"

    if [[ "$PUSH" -eq 1 ]]; then
        if ! check_login; then
            exit 3
        fi
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        dry_run_lines
    else
        run_build || exit $?
        if [[ "$PUSH" -eq 1 ]]; then
            run_push || exit $?
        fi
    fi

    log "done"
    log "tags:"
    for tag in "${TAGS[@]}"; do
        printf '  %s:%s\n' "$REPO" "$tag"
    done
}

main "$@"
