# Omni Control Plane - Cluster Configuration
# Copy this to cluster.env and adjust values

# Control Plane
CONTROL_PLANE_HOST=192.168.1.100

# K3s Settings
K3S_TOKEN=your-secret-token-here
K3S_VERSION=v1.31.3+k3s1

# SSH
SSH_KEY=~/.ssh/id_rsa

# Optional: Additional K3s arguments
# K3S_EXTRA_ARGS="--tls-san=my-domain.com"

# Worker nodes (space-separated)
WORKER_HOSTS="192.168.1.101 192.168.1.102"

# Docker/vast.ai nodes (space-separated)
DOCKER_HOSTS=""

# Node labels (applied to all workers)
# NODE_LABELS="environment=production"
