# Omni Control Plane - Docker Configuration
# Copy to cluster.env and adjust values

# Control Plane
CONTROL_PLANE_HOST=192.168.1.100

# K3s Token (generate a secure one!)
K3S_TOKEN=my-super-secret-token

# K3s Version
K3S_VERSION=v1.31.3+k3s1

# SSH Key path on your local machine
SSH_KEY_PATH=~/.ssh/id_rsa

# Worker nodes (for add-worker service)
WORKER_HOST=192.168.1.101

# Docker nodes (for add-docker service)
DOCKER_HOST=vast-host.example.com
DOCKER_MODE=tunnel
